---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ContactSection.astro';
import ibarakiBg from '../assets/images/ibaraki_bg.png';
import privacyMb from '../assets/images/privacy_mb.png';

const ogImageSrc = (await getImage({ src: privacyMb, width: 1200 })).src;

const articles = [
  {
    num: '01',
    title: '個人情報の管理',
    body: `株式会社イトピック（以下「当社」）は、お客様の個人情報を正確かつ最新の状態に保ち、個人情報への不正アクセス・紛失・破損・改ざん・漏洩などを防止するため、セキュリティシステムの維持・管理体制の整備・社員教育の徹底等の必要な措置を講じ、安全対策を実施し個人情報の厳重な管理を行います。`,
  },
  {
    num: '02',
    title: '個人情報の利用目的',
    body: `お客様からお預かりした個人情報は、当社からのご連絡や業務のご案内・ご質問に対する回答として、電子メールや資料のご送付に利用するものです。`,
  },
  {
    num: '03',
    title: '個人情報の第三者への開示・提供の禁止',
    body: `当社は、お客様よりお預かりした個人情報を適切に管理し、次のいずれかに該当する場合を除き、個人情報を第三者に開示いたしません。`,
    items: [
      'お客様の同意がある場合',
      'お客様が希望されるサービスを提供するために当社が業務を委託する業者に対して開示する場合',
      '法令に基づき開示することが必要である場合',
    ],
  },
  {
    num: '04',
    title: '個人情報の安全対策',
    body: `当社は、個人情報の正確性及び安全性確保のために、セキュリティに万全の対策を講じています。`,
  },
  {
    num: '05',
    title: 'ご本人の照会',
    body: `お客様がご本人の個人情報の照会・修正・削除などをご希望される場合には、ご本人であることを確認の上、対応させていただきます。`,
  },
  {
    num: '06',
    title: '法令、規範の遵守と見直し',
    body: `当社は、保有する個人情報に関して適用される日本の法令、その他規範を遵守するとともに、本ポリシーの内容を適宜見直し、その改善に努めます。`,
  },
  {
    num: '07',
    title: 'お問い合わせ窓口',
    body: `本ポリシーに関するお問い合わせは、下記の窓口までお願いいたします。`,
    isContact: true,
  },
];
---
<Layout
  title="プライバシーポリシー | 株式会社 イトピック"
  description="株式会社イトピックの個人情報保護方針。個人情報の取得・利用目的、第三者提供の制限、安全管理措置など、お客様の個人情報を適切に保護するための基本方針と取り組みを掲載しています。"
  ogType="article"
  ogImage={ogImageSrc}
>
<main>

  <section
    id="page-hero-privacy"
    class="w-full bg-white relative overflow-hidden max-h-[455px] min-h-[clamp(200px,28vw,455px)]"
  >
    <div
      class="hidden md:block absolute inset-y-0 right-0 w-full max-w-[1440px] pointer-events-none select-none left-1/2 -translate-x-1/2 z-0"
      aria-hidden="true"
    >
      <div class="absolute top-0 right-0 w-[clamp(260px,28vw,420px)] h-[clamp(260px,28vw,420px)] opacity-[0.55]">
        <Image src={ibarakiBg} alt="" class="w-full h-full object-contain object-right-top" />
      </div>
    </div>
    <div class="relative z-10 w-full max-w-[1440px] mx-auto flex flex-col justify-center px-6 md:px-8 lg:px-0 min-h-[clamp(200px,28vw,455px)]">
      <p class="font-inter font-bold text-[#4982C2] tracking-[0.18em] mb-4"  style="font-size: var(--fs-small);">Privacy Policy</p>
      <h1 data-title-anim class="font-noto font-bold text-[#333333] leading-tight mb-6"  style="font-size: var(--fs-display);">プライバシーポリシー</h1>
      <nav aria-label="パンくずリスト">
        <ol class="flex items-center gap-2 flex-wrap">
          <li>
            <a href="/"
               class="font-noto font-medium text-[#333333] hover:text-[#004896] transition-colors duration-200"  style="font-size: var(--fs-small);">ホーム</a>
          </li>
          <li class="font-noto font-medium text-[#333333]"  aria-hidden="true" style="font-size: var(--fs-small);">&gt;</li>
          <li class="font-noto font-medium text-[#333333]"  aria-current="page" style="font-size: var(--fs-small);">プライバシーポリシー</li>
        </ol>
      </nav>
    </div>
  </section>

  <div data-mv-parallax class="relative w-full overflow-hidden h-[clamp(240px,40vw,600px)]">
    <Image src={privacyMb} alt="プライバシーポリシーメインビジュアル"
           loading="eager"
           class="mv-parallax-img absolute w-full object-cover object-center" />
  </div>

  <section class="w-full bg-[#F0F6FA] section-md">
    <div data-a="fade" class="w-full max-w-[1440px] mx-auto px-6 md:px-8 lg:px-0 flex flex-col items-center text-center">
      <p class="font-inter font-bold text-[#4982C2] tracking-[0.22em] mb-6 md:mb-8 opacity-70"  style="font-size: var(--fs-small);">Our Commitment</p>
      <h2 class="font-noto font-bold text-[#004896] leading-tight mb-10"  style="font-size: var(--fs-h2);">個人情報保護方針</h2>
      <p class="font-noto font-medium leading-loose max-w-2xl mx-auto text-left opacity-90"  style="font-size: var(--fs-body-lg);">
        株式会社イトピック（以下「当社」）は、お客様の個人情報保護を重要な経営課題と位置づけ、以下の方針に基づき個人情報の適切な保護に努めます。
      </p>
    </div>
  </section>

  <section class="w-full bg-white section-lg">
    <div class="w-full max-w-[1440px] mx-auto px-6 md:px-8 lg:px-0">

      <div data-a="fade" class="mb-14 md:mb-20">
        <p class="font-inter font-bold text-[#4982C2] tracking-[0.18em] mb-4"  style="font-size: var(--fs-small);">Articles</p>
        <h2 class="font-noto font-bold text-[#004896] leading-tight"  style="font-size: var(--fs-h3);">各条項</h2>
      </div>

      <div class="border-t border-[#E0E6EF]">
        {articles.map((article) => (
          <div data-a="fade" class="grid grid-cols-1 md:grid-cols-[300px_1fr] border-b border-[#E0E6EF] py-10 md:py-14 gap-4 md:gap-x-20 md:gap-y-0">

            <div class="flex flex-col gap-2">
              <span class="font-inter font-bold text-[#D1D9E6] leading-none"  style="font-size: var(--fs-h1);">
                {article.num}
              </span>
              <p class="font-noto font-bold text-[#004896] leading-normal"  style="font-size: var(--fs-h4);">
                {article.title}
              </p>
            </div>

            <div class="flex flex-col justify-center">
              {article.isContact ? (
                <div>
                  <p class="font-noto font-medium text-[#333333] leading-loose mb-5"  style="font-size: var(--fs-body);">
                    {article.body}
                  </p>
                  <div class="grid gap-x-4 gap-y-3 font-noto font-medium text-[#333333] grid-cols-[5.5rem_1fr]"  style="font-size: var(--fs-body);">
                    <span class="text-[#004896] font-bold">社名</span>
                    <span>株式会社イトピック</span>
                    <span class="text-[#004896] font-bold">所在地</span>
                    <span>〒311-4163 茨城県水戸市加倉井町341-6</span>
                    <span class="text-[#004896] font-bold">電話番号</span>
                    <span>
                      <a href="tel:0292534387"
                         class="underline underline-offset-2 hover:text-[#004896] transition-colors duration-200">
                        029-253-4387
                      </a>
                      （平日 9:00〜18:00）
                    </span>
                    <span class="text-[#004896] font-bold">メール</span>
                    <span>
                      <a href="/contact"
                         class="underline underline-offset-2 hover:text-[#004896] transition-colors duration-200">
                        お問い合わせフォームよりご連絡ください
                      </a>
                    </span>
                  </div>
                </div>
              ) : article.items ? (
                <div>
                  <p class="font-noto font-medium text-[#333333] leading-loose mb-5"  style="font-size: var(--fs-body);">
                    {article.body}
                  </p>
                  <ul class="space-y-3">
                    {article.items.map((item: string) => (
                      <li class="flex items-start gap-2 font-noto font-medium text-[#333333] leading-relaxed"  style="font-size: var(--fs-body);">
                        <span class="flex-shrink-0 text-[#4982C2] font-bold mt-0.5" aria-hidden="true">・</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : (
                <p class="font-noto font-medium text-[#333333] leading-loose"  style="font-size: var(--fs-body);">
                  {article.body}
                </p>
              )}
            </div>

          </div>
        ))}
      </div>

      <div class="mt-14 md:mt-20 flex flex-col md:flex-row md:items-center md:justify-between gap-4 pt-8 border-t border-[#E0E6EF]">
        <p class="font-noto font-medium text-[#999999]"  style="font-size: var(--fs-caption);">
          制定日：2020年4月1日　/　最終改定日：2026年1月1日
        </p>
        <p class="font-noto font-bold text-[#333333]"  style="font-size: var(--fs-small);">
          株式会社イトピック　代表取締役　藤田 和男
        </p>
      </div>

    </div>
  </section>

  <ContactSection />

</main>
</Layout>
