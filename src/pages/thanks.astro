---
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ContactSection.astro';
---
<Layout
  title="送信完了 | 株式会社イトピック"
  description="お問い合わせを受け付けました。株式会社イトピックより2営業日以内に担当者よりご連絡いたします。お急ぎの場合はお電話（029-253-4387・受付時間：平日 9:00〜18:00（土日祝を除く））でもお問い合わせください。"
  ogType="article"
  noindex={true}
  bodyClass="font-noto text-[#333333] bg-[#F0F6FA] min-h-screen"
>
<main>

  <section class="w-full min-h-screen flex items-center justify-center px-6 py-20">
    <div class="w-full max-w-[680px] mx-auto">

      <div class="bg-white rounded-[16px] overflow-hidden shadow-sm px-8 py-14 md:px-16 md:py-20 text-center">

        <div class="flex justify-center mb-8">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52" class="w-[72px] h-[72px]">
            <circle class="check-circle" cx="26" cy="26" r="25"
                    fill="none" stroke="#004896" stroke-width="2" />
            <path class="check-mark"
                  fill="none" stroke="#004896" stroke-width="3"
                  stroke-linecap="round" stroke-linejoin="round"
                  d="M14 27l8 8 16-16" />
          </svg>
        </div>

        <div class="fade-up fade-up-1">
          <p class="font-inter font-bold text-[#4982C2] tracking-[0.2em] mb-3"  style="font-size: var(--fs-caption);">THANK YOU</p>
          <h1 data-title-anim class="font-noto font-bold text-[#004896] leading-tight mb-6"  style="font-size: var(--fs-h2);">
            お問い合わせを受け付けました
          </h1>
        </div>

        <div class="fade-up fade-up-2">
          <div class="w-12 h-[2px] bg-[#4982C2] mx-auto mb-8"></div>
        </div>

        <div class="fade-up fade-up-3">
          <p class="font-noto font-medium text-[#333333] leading-loose mb-4"  style="font-size: var(--fs-body-lg);">
            この度はお問い合わせいただき、誠にありがとうございます。<br />
            内容を確認の上、担当者より<strong class="text-[#004896]">2営業日以内</strong>にご連絡いたします。
          </p>
          <p class="font-noto font-medium text-[#777] leading-loose"  style="font-size: var(--fs-small);">
            自動返信メールをお送りしております。<br />
            届かない場合は迷惑メールフォルダをご確認ください。
          </p>
        </div>

        <div class="fade-up fade-up-4 mt-12 flex flex-col items-center gap-4">
          <a href="https://cloudflare-workers-autoconfig-itpc.snsstartdiary.workers.dev/"
             class="group font-noto font-bold text-white inline-flex items-center justify-center gap-3 rounded-[8px] transition-opacity duration-300 hover:opacity-85 bg-[linear-gradient(to_right,#4982C2,#004896)] py-4 px-12"  style="font-size: var(--fs-body-lg);">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 class="w-4 h-4 transition-transform duration-300 group-hover:-translate-x-1">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            トップページへ戻る
          </a>
          <p class="font-noto font-medium text-[#AAAAAA]"  style="font-size: var(--fs-caption);">
            <span id="countdown">10</span> 秒後に自動的にトップページへ移動します
          </p>
        </div>

      </div>

      <div class="mt-6 bg-[#004896] rounded-[12px] px-6 py-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4 fade-up fade-up-4">
        <div>
          <p class="font-noto font-medium text-white opacity-70 mb-1"  style="font-size: var(--fs-caption);">お急ぎの方はお電話でもお問い合わせいただけます</p>
          <p class="font-noto font-medium text-white opacity-60"  style="font-size: var(--fs-caption);">受付時間：平日 9:00〜18:00（土日祝を除く）</p>
        </div>
        <a href="tel:0292534387" class="flex items-center gap-3 flex-shrink-0 group">
          <div class="w-9 h-9 rounded-full bg-white bg-opacity-20 flex items-center justify-center group-hover:bg-opacity-30 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                 stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 9.81 19.79 19.79 0 0 1 1.08 1.18 2 2 0 0 1 3.08 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <span class="font-inter font-bold text-white tracking-[0.04em] leading-none"  style="font-size: var(--fs-h3);">
            029-253-4387
          </span>
        </a>
      </div>

    </div>
  </section>

  <ContactSection />

</main>
</Layout>

<script>
  (function () {
    var count = 10;
    var el = document.getElementById('countdown');
    var timer = setInterval(function () {
      count--;
      if (el) el.textContent = String(count);
      if (count <= 0) {
        clearInterval(timer);
        window.location.href = 'https://cloudflare-workers-autoconfig-itpc.snsstartdiary.workers.dev/';
      }
    }, 1000);
  })();
</script>

<style>
  .check-circle {
    stroke-dasharray: 166;
    stroke-dashoffset: 166;
    animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
  }
  .check-mark {
    stroke-dasharray: 48;
    stroke-dashoffset: 48;
    animation: stroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.8s forwards;
  }
  @keyframes stroke {
    100% { stroke-dashoffset: 0; }
  }
  .fade-up {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.6s ease forwards;
  }
  .fade-up-1 { animation-delay: 1.0s; }
  .fade-up-2 { animation-delay: 1.2s; }
  .fade-up-3 { animation-delay: 1.4s; }
  .fade-up-4 { animation-delay: 1.6s; }
  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }
  #countdown { font-variant-numeric: tabular-nums; }
</style>
