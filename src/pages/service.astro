    // PC ONLY
    // ═══════════════════════════════════════════════════════════════════
    serviceMm.add('(min-width: 768px)', function () {

      const pcWrap = document.querySelector<HTMLElement>('.hero-content-wrap');
      const pcImg  = document.querySelector<HTMLElement>('#svc-hero-pc-img');
      const pcTxt  = document.querySelector<HTMLElement>('#svc-hero-pc-txt');

      if (pcWrap && pcImg && pcTxt) {
        gsap.set(pcImg, { opacity: 0, x: -48 });
        gsap.set(pcTxt, { opacity: 0, x: 48 });

        const tlHero = gsap.timeline({
          scrollTrigger: { trigger: pcWrap, start: 'top 80%', once: true },
        });
        tlHero
          .to(pcImg, { opacity: 1, x: 0, duration: 0.8, ease: 'power2.out' })
          .to(pcTxt, { opacity: 1, x: 0, duration: 0.8, ease: 'power2.out' }, '-=0.5');
      }

      function buildShutterReveal(card: HTMLElement) {
        const imgCol = card.querySelector<HTMLElement>('.svc-card-img-col');
        if (!imgCol) return;
        const img = imgCol.querySelector<HTMLElement>('img');
        if (!img) return;

        gsap.set(img, {
          clipPath: 'inset(0 100% 0 0 round 4px)',
          scale: 1.08,
          transformOrigin: 'center center',
        });

        gsap.to(img, {
          clipPath: 'inset(0 0% 0 0 round 4px)',
          scale: 1,
          duration: 1.2,
          ease: 'power4.inOut',
          scrollTrigger: {
            trigger: imgCol,
            start: 'top 78%',
            once: true,
          },
        });
      }

      function animateTextCol(card: HTMLElement) {
        const txtCol = card.querySelector<HTMLElement>('.svc-card-txt-col');
        if (!txtCol) return;
        gsap.fromTo(txtCol,
          { opacity: 0, x: -40 },
          {
            opacity: 1, x: 0,
            duration: 0.8, ease: 'power2.out',
            scrollTrigger: { trigger: card, start: 'top 76%', once: true },
          }
        );
      }

      ['design', 'novelty', 'video'].forEach(function (id) {
        const card = document.getElementById(id);
        if (!card) return;
        buildShutterReveal(card);
        animateTextCol(card);
      });

    }); // end PC

    // ═══════════════════════════════════════════════════════════════════
    // SP ONLY
    // ═══════════════════════════════════════════════════════════════════
    serviceMm.add('(max-width: 1023px)', function () {
      ['design', 'novelty', 'video'].forEach(function (id) {
        const card = document.getElementById(id);
        if (!card) return;
        gsap.set(card, { opacity: 0, y: 40 });
        gsap.to(card, {
          opacity: 1, y: 0, duration: 0.9, ease: 'power2.out',
          scrollTrigger: { trigger: card, start: 'top 88%', once: true },
        });
      });
    }); // end SP
  }

  document.addEventListener('astro:page-load', initServiceAnimations);
</script>

<script>
  function initServiceAccordion() {
    if (!document.querySelector('[data-page="service"]')) return;
    document.querySelectorAll<HTMLButtonElement>('.accordion-trigger').forEach(function (btn) {
      if (btn.dataset.accordionBound === 'true') return;
      btn.dataset.accordionBound = 'true';
      btn.addEventListener('click', function () {
        const panelId = btn.getAttribute('data-target')!;
        const panel = document.getElementById(panelId)!;
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        const plus = btn.querySelector('.acc-plus');
        const minus = btn.querySelector('.acc-minus');
        if (isOpen) {
          panel.style.maxHeight = '0';
          btn.setAttribute('aria-expanded', 'false');
          if (plus) plus.classList.remove('hidden');
          if (minus) minus.classList.add('hidden');
        } else {
          panel.style.maxHeight = panel.scrollHeight + 'px';
          btn.setAttribute('aria-expanded', 'true');
          if (plus) plus.classList.add('hidden');
          if (minus) minus.classList.remove('hidden');
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initServiceAccordion);
</script>
