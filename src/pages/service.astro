---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ContactSection.astro';
import ibarakiBg from '../assets/images/ibaraki_bg.png';
import seaviceMain from '../assets/images/seavice_main.png';
import servicesMain from '../assets/images/services_main.JPG';
import serviceHiroMain from '../assets/images/service_hiro_main.png';
import printImg from '../assets/images/print_img.png';
import goodsImg from '../assets/images/goods_img.png';
import movieImg from '../assets/images/movie_img.png';

const ogImageSrc = (await getImage({ src: seaviceMain, width: 1200 })).src;
---
<Layout
  title="事業内容 | 株式会社 イトピック"
  description="式典・イベントの企画から当日運営まで一貫対応。デザイン・印刷、映像制作、ノベルティ・商品手配など、イベント成功に必要なサービスを茨城県水戸市のイトピックがトータルでご提供します。"
  ogType="article"
  ogImage={ogImageSrc}
>
<main data-page="service">

  <!-- PAGE HERO -->
  <section id="page-hero-services"
    class="w-full bg-white relative overflow-hidden"
   
  >
    <div class="hidden md:block absolute inset-y-0 right-0 w-full max-w-[1440px] pointer-events-none select-none left-1/2 -translate-x-1/2 z-0" aria-hidden="true">
      <div class="absolute top-0 right-0 w-[clamp(260px,28vw,420px)] h-[clamp(260px,28vw,420px)] opacity-[0.55]">
        <Image src={ibarakiBg} alt="" class="w-full h-full object-contain object-right-top" />
      </div>
    </div>
    <div class="relative z-10 w-full max-w-[1440px] mx-auto flex flex-col justify-center px-6 md:px-8 lg:px-0 min-h-[clamp(200px,28vw,455px)]">
      <p class="font-inter font-bold text-[#4982C2] tracking-widest mb-4 tracking-[0.18em]"  style="font-size: var(--fs-small);">Services</p>
      <h1 data-title-anim class="font-noto font-bold text-[#333333] leading-tight mb-6"  style="font-size: var(--fs-display);">事業内容</h1>
      <nav aria-label="パンくずリスト">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="font-noto font-medium text-[#333333] hover:text-[#004896] transition-colors duration-200"  style="font-size: var(--fs-small);">ホーム</a></li>
          <li class="font-noto font-medium text-[#333333]"  aria-hidden="true" style="font-size: var(--fs-small);">&gt;</li>
          <li class="font-noto font-medium text-[#333333]"  aria-current="page" style="font-size: var(--fs-small);">事業内容</li>
        </ol>
      </nav>
    </div>
  </section>

  <!-- MAIN VISUAL -->
  <div data-mv-parallax class="relative w-full overflow-hidden h-[clamp(240px,40vw,600px)]">
    <Image src={seaviceMain} alt="事業内容メインビジュアル" loading="eager" class="mv-parallax-img absolute w-full object-cover object-center" />
  </div>

  <!-- HERO 01 -->
  <section id="service-hero-01" class="w-full bg-white flex items-center justify-center min-h-[clamp(360px,50vw,728px)]">
      <div data-a="fade" class="w-full max-w-[1440px] mx-auto px-6 md:px-8
                flex flex-col items-center justify-center text-center section-md">
      <p class="font-inter font-bold text-[#4982C2] tracking-widest mb-6 md:mb-8 tracking-[0.2em]"  style="font-size: var(--fs-small);">Main Service</p>
      <h2 class="font-noto font-bold text-[#004896] leading-snug mb-10 tracking-[0.05em]"  style="font-size: var(--fs-h1);">
        式典・イベントの<br />企画から運営までをサポート。
      </h2>
      <div class="font-noto font-medium text-[#333333] leading-loose space-y-2 text-left md:text-center w-full"  style="font-size: var(--fs-body-lg);">
        <p>行政機関・自治体向けのイベント企画から運営まで、創業からの実績とノウハウで確かなサポートを提供します。</p>
        <p>記念式典、周年行事、地域イベントなど、あらゆる規模のプロジェクトに対応します。</p>
      </div>
    </div>
  </section>

  <!-- HERO 02 -->
  <section id="service-hero-02" class="w-full relative min-h-[clamp(600px,180vw,calc(705px+750px+200px))]">
    <div id="svc-hero-bg-wrap" class="absolute top-0 left-0 w-full overflow-hidden h-[clamp(220px,55vw,1000px)] z-0">
      <Image id="svc-hero-bg-img" src={servicesMain} alt="" aria-hidden="true" class="w-full h-full object-cover object-center" />
      <div class="hidden md:block absolute inset-0 bg-[linear-gradient(to_bottom,rgba(73,145,178,0.52)_0%,rgba(73,145,178,0.38)_28%,rgba(255,255,255,0.72)_62%,rgba(255,255,255,0.96)_82%,rgba(255,255,255,1)_100%)]"></div>
      <div class="md:hidden absolute inset-0 bg-[linear-gradient(to_bottom,rgba(73,145,178,0.45)_0%,rgba(73,145,178,0.30)_50%,rgba(73,145,178,0.10)_100%)]"></div>
    </div>

    <!-- PC -->
    <div class="hero-content-wrap hidden md:block absolute w-full max-w-[1440px] px-0 top-[705px] left-1/2 -translate-x-1/2 z-10">
      <div class="flex flex-row items-start gap-x-fluid-2col pb-[var(--sp-section-xl)]">
        <div id="svc-hero-pc-img" class="col-media overflow-hidden rounded-[4px] h-[clamp(320px,50vw,750px)]">
          <Image src={serviceHiroMain} alt="企画・運営の現場" class="w-full h-full object-cover object-center" />
        </div>
        <div id="svc-hero-pc-txt" class="flex-1 min-w-0 pt-0 mb-12">
          <div class="mb-[var(--sp-gap-md)]">
            <span class="font-noto font-bold text-white rounded-[2px] bg-[linear-gradient(to_right,#004896,#3C73B5)] block w-fit py-2.5 px-5 mb-1.5"  style="font-size: var(--fs-h2);">
              企画運営の成功を支える、
            </span>
            <span class="font-noto font-bold text-white rounded-[2px] bg-[linear-gradient(to_right,#004896,#3C73B5)] block w-fit py-2.5 px-5"  style="font-size: var(--fs-h2);">
              トータルプロデュースの力
            </span>
          </div>
          <h3 class="font-noto font-bold text-[#004896] tracking-[0.02em] leading-normal mt-[var(--sp-gap-lg)] mb-[var(--sp-gap-lg)]"  style="font-size: var(--fs-h3);">
            企画立案から当日の運営、<br />付随する各種クリエイティブ制作まで。
          </h3>
          <div class="font-noto font-medium text-[#333333] leading-loose space-y-5"  style="font-size: var(--fs-body-lg);">
            <p>私たちは、イベント成功に必要なすべてのプロセスをワンストップでサポートします。</p>
            <p>記録映像やオープニングムービーの制作、集客のための印刷物、効果的なノベルティ提案など、各分野の専門ノウハウを統合し、主催者様の想いを形にします。</p>
            <p>窓口を一本化することで、一貫性のある高品質なプロモーションを可能にします。</p>
          </div>
        </div>
      </div>
    </div>

    <!-- SP -->
    <div class="md:hidden relative z-10 w-full bg-transparent pt-[clamp(120px,35vw,200px)] pb-[clamp(32px,8vw,60px)]">
      <div class="px-6 py-10 bg-white rounded-t-[16px]">
        <div class="overflow-hidden rounded-[4px] w-full mb-8 h-[clamp(240px,60vw,420px)]">
          <Image src={serviceHiroMain} alt="企画・運営の現場" class="w-full h-full object-cover object-center" />
        </div>
        <div>
          <div class="mb-5">
            <span class="font-noto font-bold text-white rounded-[2px] bg-[linear-gradient(to_right,#004896,#3C73B5)] block w-fit py-2 px-4 mb-1.5"  style="font-size: var(--fs-h3);">
              企画運営の成功を支える、
            </span>
            <span class="font-noto font-bold text-white rounded-[2px] bg-[linear-gradient(to_right,#004896,#3C73B5)] block w-fit py-2 px-4"  style="font-size: var(--fs-h3);">
              トータルプロデュースの力
            </span>
          </div>
          <h3 class="font-noto font-bold text-[#004896] leading-normal mt-6 mb-6"  style="font-size: var(--fs-h3);">
            企画立案から当日の運営、<br />付随する各種クリエイティブ制作まで。
          </h3>
          <div class="font-noto font-medium text-[#333333] leading-loose space-y-4"  style="font-size: var(--fs-body);">
            <p>私たちは、イベント成功に必要なすべてのプロセスをワンストップでサポートします。</p>
            <p>記録映像やオープニングムービーの制作、集客のための印刷物、効果的なノベルティ提案など、各分野の専門ノウハウを統合し、主催者様の想いを形にします。</p>
            <p>窓口を一本化することで、一貫性のある高品質なプロモーションを可能にします。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ATTACHED SERVICES -->
  <section id="attached-services" class="w-full bg-[#F0F6FA] section-xl">
    <div class="inner">
      <div data-a="fade" class="text-center px-6 mb-[var(--sp-section-md)]">
        <p class="font-inter font-bold text-[#4982C2] tracking-widest mb-5 tracking-[0.18em]"  style="font-size: var(--fs-small);">Attached Services</p>
        <h2 class="font-noto font-bold text-[#004896] leading-tight mb-8"  style="font-size: var(--fs-h2);">合わせてご提供するサービス</h2>
        <p class="font-noto font-medium text-[#333333] leading-loose text-left md:text-center"  style="font-size: var(--fs-body);">
          式典・イベントに付随する各種クリエイティブも、ワンストップでご対応しています。<br class="hidden md:block" />
          映像制作・デザイン制作・ノベルティ手配など、目的に合わせて最適なプランをご提案します。
        </p>
      </div>

      <div class="space-y-[var(--sp-section-md)] md:space-y-[var(--sp-section-xl)]">

        <!-- 01: デザイン・印刷 -->
        <div id="design" class="bg-white rounded-[12px] overflow-hidden w-[95%] md:w-full mx-auto">
          <div class="flex flex-col md:flex-row md:items-stretch">
            <div class="svc-card-txt-col flex-1 min-w-0 px-6 py-8 md:px-[clamp(32px,5.5vw,84px)] md:py-[clamp(48px,6.5vw,96px)]">
              <h3 class="font-noto font-bold text-[#333333] mb-[var(--sp-gap-md)]"  style="font-size: var(--fs-h3);">デザイン・印刷</h3>
              <div class="h-[3px] bg-[#4982C2] w-[150px] mb-[var(--sp-gap-md)]"></div>
              <p class="font-noto font-bold text-[#004896] mb-[var(--sp-gap-lg)]"  style="font-size: var(--fs-h4);">視覚で伝えるデザインと品質</p>
              <div class="font-noto font-medium text-[#333333] leading-loose space-y-[20px]"  style="font-size: var(--fs-body);">
                <p>招待状、パンフレット、看板など、イベントに必要な各種デザイン・印刷物を制作します。統一感のあるビジュアルで、イベント全体の世界観を構築します。</p>
                <p>「わかりやすさ」と「高い品格」、そして統一感のあるビジュアル構築により、催事の価値を高めるとともに、来場者を迷わせない確実な会場導線を実現します。</p>
              </div>
            </div>
            <div class="svc-card-img-col flex-shrink-0 w-full md:w-[45%] flex items-center justify-center
                        bg-white px-6 py-8 md:px-[clamp(24px,4vw,60px)] md:py-[clamp(40px,4.5vw,64px)]">
              <Image src={printImg} alt="デザイン・印刷 実績" class="w-full md:h-[clamp(320px,45vw,650px)] object-contain" />
            </div>
          </div>
        </div>

        <!-- 02: ノベルティ・商品 -->
        <div id="novelty" class="bg-white rounded-[12px] overflow-hidden w-[95%] md:w-full mx-auto">
          <div class="flex flex-col md:flex-row md:items-stretch">
            <div class="svc-card-txt-col flex-1 min-w-0 px-6 py-8 md:px-[clamp(32px,5.5vw,84px)] md:py-[clamp(48px,6.5vw,96px)]">
              <h3 class="font-noto font-bold text-[#333333] mb-[var(--sp-gap-md)]"  style="font-size: var(--fs-h3);">ノベルティ・商品</h3>
              <div class="h-[3px] bg-[#4982C2] w-[150px] mb-[var(--sp-gap-md)]"></div>
              <p class="font-noto font-bold text-[#004896] mb-[var(--sp-gap-lg)]"  style="font-size: var(--fs-h4);">記憶に残るオリジナルグッズと価値</p>
              <div class="font-noto font-medium text-[#333333] leading-loose space-y-[20px]"  style="font-size: var(--fs-body);">
                <p>イベントの趣旨や行政事業のテーマに連動した、一貫性のあるオリジナルグッズを提案します。</p>
                <p>ターゲットの年齢層に合わせたノベルティ選定から、名入れデザイン、製造、会場への確実な納品まで一括で対応。徹底したスケジュール管理により、スムーズな催事運営を支えます。</p>
              </div>
            </div>
            <div class="svc-card-img-col flex-shrink-0 w-full md:w-[45%] flex items-center justify-center
                        bg-white px-6 py-8 md:px-[clamp(24px,4vw,60px)] md:py-[clamp(40px,4.5vw,64px)]">
              <Image src={goodsImg} alt="ノベルティ・商品 実績" class="w-full md:h-[clamp(320px,45vw,650px)] object-contain" />
            </div>
          </div>
        </div>

        <!-- 03: 映像制作 -->
        <div id="video" class="bg-white rounded-[12px] overflow-hidden w-[95%] md:w-full mx-auto">
          <div class="flex flex-col md:flex-row md:items-stretch">
            <div class="svc-card-txt-col flex-1 min-w-0 px-6 py-8 md:px-[clamp(32px,5.5vw,84px)] md:py-[clamp(48px,6.5vw,96px)]">
              <h3 class="font-noto font-bold text-[#333333] mb-[var(--sp-gap-md)]"  style="font-size: var(--fs-h3);">映像制作</h3>
              <div class="h-[3px] bg-[#4982C2] w-[150px] mb-[var(--sp-gap-md)]"></div>
              <p class="font-noto font-bold text-[#004896] mb-[var(--sp-gap-lg)]"  style="font-size: var(--fs-h4);">イベントを未来へつなぐ記録</p>
              <div class="font-noto font-medium text-[#333333] leading-loose space-y-[20px]"  style="font-size: var(--fs-body);">
                <p>式典やイベントの公式記録映像から、事業の魅力を伝えるPR動画まで、目的に合わせた最適な映像制作をご提供します。</p>
                <p>行政機関のイベントにふさわしい、「誰にでもわかりやすく、上品な映像」を制作します。ホームページや、その後のPR活動にもそのまま長く使える確実な映像をお届けします。</p>
              </div>
            </div>
            <div class="svc-card-img-col flex-shrink-0 w-full md:w-[45%] flex items-center justify-center
                        bg-white px-6 py-8 md:px-[clamp(24px,4vw,60px)] md:py-[clamp(40px,4.5vw,64px)]">
              <Image src={movieImg} alt="映像制作 実績" class="w-full md:h-[clamp(320px,45vw,650px)] object-contain" />
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- SERVICE FLOW -->
  <section id="service-flow" class="w-full bg-white pt-[var(--sp-section-xl)] pb-[var(--sp-section-sm)]">
    <div class="inner">
      <div data-a="fade" class="text-center px-6 lg:px-0 mb-[var(--sp-section-md)]">
        <p class="font-inter font-bold text-[#4982C2] tracking-widest mb-5 tracking-[0.18em]"  style="font-size: var(--fs-small);">Flow</p>
        <h2 class="font-noto font-bold text-[#004896] leading-tight mb-8"  style="font-size: var(--fs-h2);">サービスの流れ</h2>
        <p class="font-noto font-medium text-[#333333] leading-loose text-left md:text-center"  style="font-size: var(--fs-body);">
          ご相談から納品まで、一貫してサポートします。<br class="hidden md:block" />
          初めてのご依頼でも安心していただけるよう、丁寧なヒアリングと確実な進行管理をおこないます。
        </p>
      </div>

      <!-- 全体の流れ -->
      <div class="mb-[var(--sp-section-md)]">
        <div class="flex items-center gap-3 mb-[var(--sp-gap-lg)]">
          <div class="w-8 h-[3px] bg-[#004896]"></div>
          <p class="font-noto font-bold text-[#333333]"  style="font-size: var(--fs-h4);">全体の流れ</p>
        </div>
        <div data-a="fade" class="flex flex-col md:flex-row items-stretch">
          {[
            { num: '1', label: '打ち合わせ\n御見積り', last: false },
            { num: '2', label: '企画\n制作準備', last: false },
            { num: '3', label: '内容確認\n最終調整', last: false },
            { num: '4', label: '運営\n制作実施', last: false },
            { num: '5', label: '納品\n完了報告', last: true },
          ].map(({ num, label, last }) => (
            <div class="flex md:contents flex-col items-center flex-[1_1_0%]">
              <div class="relative overflow-hidden rounded-[6px] flex flex-col justify-end
                          px-5 pb-5 bg-[#004896] w-[60%] md:w-full mx-auto md:mx-0 min-h-[clamp(150px,12vw,160px)]">
                <span class="absolute top-2 right-3 font-inter font-bold text-white select-none leading-none opacity-[0.18]"  style="font-size: var(--fs-display);">{num}</span>
                <p class="font-noto font-bold text-white leading-snug relative z-10" 
                   set:html={label.replace('\n', '<br />')}></p>
              </div>
              {!last && (
                <div class="flex items-center justify-center flex-shrink-0 self-center w-12 h-12 mx-1">
                  <div class="w-8 h-8 rounded-full border border-[#004896] flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                         stroke="#004896" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         class="w-4 h-4 rotate-90 md:rotate-0">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- 各ステップの詳細（アコーディオン） -->
      <div class="mx-0 md:mx-0">
        <div class="flex items-center gap-3 mb-[var(--sp-gap-lg)]">
          <div class="w-8 h-[3px] bg-[#004896]"></div>
          <p class="font-noto font-bold text-[#333333]"  style="font-size: var(--fs-h4);">各ステップの詳細</p>
        </div>

        <div data-a="stagger" class="px-6 lg:px-0 space-y-4 w-full mx-0">

          <!-- 1: イベント企画 -->
          <div class="border border-[#D8E4F0] rounded-[8px] overflow-hidden">
            <button type="button" class="accordion-trigger w-full flex items-center justify-between
                           px-8 py-8 md:px-[48px] md:py-[40px] text-left bg-white
                           hover:bg-[#F0F6FA] transition-colors duration-200"
                    aria-expanded="false" data-target="acc-panel-1">
              <span class="font-noto font-bold text-[#004896]"  style="font-size: var(--fs-h4);">イベント企画</span>
              <span class="acc-icon flex-shrink-0 w-8 h-8 rounded-full border border-[#004896]
                           text-[#004896] flex items-center justify-center ml-4" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-4 h-4 acc-plus">
                  <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-4 h-4 acc-minus hidden">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </span>
            </button>
            <div id="acc-panel-1" class="accordion-panel accordion-panel-inner max-h-0 overflow-hidden transition-[max-height] duration-[400ms] ease-[cubic-bezier(0.4,0,0.2,1)]">
              <div class="px-8 pb-10 pt-[30px] md:px-[48px] md:pb-[40px] bg-white">
                <ol class="relative">
                  <div class="absolute left-[15px] top-[32px] bottom-[32px] w-[1px] bg-[#D8E4F0]" aria-hidden="true"></div>
                  <li class="flex gap-[26px] mb-[40px]"><span class="flex-shrink-0 w-8 h-8 rounded-full bg-[#004896] flex items-center justify-center font-inter font-bold text-white text-sm relative z-10">1</span><div><p class="font-noto font-bold text-[#004896] mb-1"  style="font-size: var(--fs-small);">打ち合わせ</p></div></li>
                  <li class="flex gap-[26px] mb-[40px]"><span class="flex-shrink-0 w-8 h-8 rounded-full bg-[#004896] flex items-center justify-center font-inter font-bold text-white text-sm relative z-10">2</span><div><p class="font-noto font-bold text-[#004896] mb-1"  style="font-size: var(--fs-small);">御見積り</p></div></li>
