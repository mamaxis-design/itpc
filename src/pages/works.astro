<script>
  function worksShowTab(id: string, btn: HTMLElement) {
    document.querySelectorAll('.works-tab-panel').forEach(function(p) {
      p.classList.remove('active');
    });
    document.querySelectorAll<HTMLElement>('.works-tab-btn').forEach(function(b) {
      b.classList.remove('active');
      b.classList.remove('text-[#004896]');
      b.classList.add('text-[#999]');
      const span = b.querySelector<HTMLElement>('span:last-child');
      if (span) span.style.backgroundColor = '#D1D1D1';
    });
    document.getElementById('works-panel-' + id)?.classList.add('active');
    btn.classList.add('active');
    btn.classList.remove('text-[#999]');
    btn.classList.add('text-[#004896]');
    const activeSpan = btn.querySelector<HTMLElement>('span:last-child');
    if (activeSpan) activeSpan.style.backgroundColor = '#004896';
  }

  function initWorksPage() {
    if (!document.querySelector('.works-tab-panel')) return;
    (window as any).worksShowTab = worksShowTab;

    // カウンターアニメーション（Numbers section）
    function easeOutQuart(t: number) { return 1 - Math.pow(1 - t, 4); }

    function animateCounter(el: HTMLElement) {
      const target = parseInt(el.dataset.target ?? '0', 10);
      const isComma = el.dataset.format === 'comma';
      const duration = 1800;
      const start = performance.now();
      function format(n: number) {
        return isComma ? Math.floor(n).toLocaleString('ja-JP') : Math.floor(n).toString();
      }
      function step(now: number) {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const ease = easeOutQuart(progress);
        el.textContent = format(target * ease);
        if (progress < 1) requestAnimationFrame(step);
        else el.textContent = format(target);
      }
      requestAnimationFrame(step);
    }

    const counters = document.querySelectorAll<HTMLElement>('.js-counter');
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            animateCounter(entry.target as HTMLElement);
            obs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.4 });
      counters.forEach(function (el) { obs.observe(el); });
    }

    // ドーナツチャート + 比率カウンター
    const CIRCUMFERENCE = 2 * Math.PI * 75;
    function easeOutQuart(t: number) { return 1 - Math.pow(1 - t, 4); }

    function animateDonut() {
      const segs = [
        { el: document.getElementById('seg1')!, pct: 44, offset: 0,  gap: 2 },
        { el: document.getElementById('seg2')!, pct: 20, offset: 44, gap: 2 },
        { el: document.getElementById('seg3')!, pct: 36, offset: 64, gap: 2 },
      ];
      const centerEl = document.getElementById('donut-center-num')!;
      const TARGET_TOTAL = 100;
      const duration = 1600;
      const start = performance.now();

      function step(now: number) {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const ease = easeOutQuart(progress);
        segs.forEach(function (s) {
          const drawn = CIRCUMFERENCE * (s.pct / 100) * ease;
          const gap = s.pct > 0 ? s.gap : 0;
          const dashArray = (drawn - gap) + ' ' + (CIRCUMFERENCE - drawn + gap);
          const dashOffset = -(CIRCUMFERENCE * (s.offset / 100));
          s.el.setAttribute('stroke-dasharray', dashArray);
          s.el.setAttribute('stroke-dashoffset', String(dashOffset));
        });
        if (centerEl) centerEl.textContent = String(Math.floor(TARGET_TOTAL * ease));
        if (progress < 1) requestAnimationFrame(step);
        else if (centerEl) centerEl.textContent = String(TARGET_TOTAL);
      }
      requestAnimationFrame(step);
    }

    function animateRatioCounters() {
      document.querySelectorAll<HTMLElement>('.js-ratio-counter').forEach(function (el) {
        const target = parseInt((el as any).dataset.target, 10);
        const duration = 1600;
        const start = performance.now();
        function step(now: number) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          el.textContent = String(Math.floor(target * easeOutQuart(progress)));
          if (progress < 1) requestAnimationFrame(step);
          else el.textContent = String(target);
        }
        requestAnimationFrame(step);
      });
    }

    const section = document.getElementById('works-ratio');
    if (section && 'IntersectionObserver' in window) {
      let fired = false;
      const obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting && !fired) {
            fired = true;
            animateDonut();
            animateRatioCounters();
            obs.unobserve(section);
          }
        });
      }, { threshold: 0.25 });
      obs.observe(section);
    }
  }

  document.addEventListener('astro:page-load', initWorksPage);
</script>
