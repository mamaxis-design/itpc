---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ContactSection.astro';
import ibarakiBg from '../assets/images/ibaraki_bg.png';
import worksMb from '../assets/images/works_mb.jpg';
import worksMain from '../assets/images/works_main.JPG';
import worksBg from '../assets/images/works_bg.jpg';

const worksImageModules = import.meta.glob<{ default: ImageMetadata }>('../assets/images/works_*.{jpg,JPG,png}', { eager: true });
const worksImageMap: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(worksImageModules)) {
  const filename = path.split('/').pop() ?? '';
  worksImageMap[filename] = mod.default;
}

const ogImageSrc = (await getImage({ src: worksMb, width: 1200 })).src;

const characterWorksList = [
  ['高萩市ブランドイメージキャラクター 「はぎまろ」(着ぐるみ・PR ツール)', '高萩市'],
  ['常陸大宮市マスコットキャラクター 「ひたまる」(着ぐるみ・PR ツール)', '常陸大宮市'],
  ['牛久市イメージキャラクター 「きゅーちゃん」(着ぐるみ)', '牛久市'],
  ['笠間市イメージキャラクター 「いな吉」(着ぐるみ)', '笠間市'],
  ['潮来市イメージキャラクター 「あやめちゃん」(着ぐるみ)', '潮来市'],
  ['水戸商工会議所イメージキャラクター 「いきいき黄門さま」(着ぐるみ・PR ツール)', '水戸商工会議所'],
  ['城里町イメージキャラクター 「ホロル」(着ぐるみ)', '城里町'],
  ['土浦市イメージキャラクター 「つちまる」(着ぐるみ・シール)', '土浦市'],
  ['五霞町イメージキャラクター 「ごかりん」(着ぐるみ)', '五霞町'],
  ['筑西市イメージキャラクター 「ちっくん」(着ぐるみ)', '筑西市'],
  ['いばらき総文 2014 イメージキャラクター 「ふれあちゃん」(着ぐるみ)', '茨城県'],
  ['アクアワールド茨城県大洗水族館 イメージキャラクター「ピルル・ブルル」(着ぐるみ)', 'アクアワールド茨城県大洗水族館'],
  ['龍ケ崎市イメージキャラクター 「まいりゅう」(着ぐるみ・PR ツール)', '龍ケ崎市'],
  ['大洗町ブランドイメージキャラクター 「アライッペ」(着ぐるみ・PR ツール)', '大洗町'],
  ['石岡市マスコットキャラクター 「ししまる君」(着ぐるみ)', '石岡市'],
  ['神栖市イメージキャラクター 「カミスココくん」(着ぐるみ)', '神栖市'],
  ['常陸太田市マスコットキャラクター 「じょうづるさん」(着ぐるみ)', '常陸太田市'],
  ['牛久市観光協会マスコットキャラクター 「かっぱのキューちゃん」(30cmぬいぐるみ)', '牛久市観光協会'],
  ['かすみがうら市公式キャラクター 「かすみがうにゃ」(着ぐるみ)', 'かすみがうら市'],
  ['土浦市マスコットキャラクター 「キララちゃん」(エアー着ぐるみ)', '土浦市'],
  ['桜川市マスコットキャラクター 「さくりん」(着ぐるみ・ぬいぐるみ)', '桜川市'],
].reverse();

const characterWorksTableExtra: [string, string][] = [
  ['稲敷市マスコットキャラクター 「稲敷いなのすけ」(着ぐるみ)', '稲敷市'],
];

function splitCharacterTitle(title: string): { main: string; note: string | null; inlineNote: boolean } {
  const idx = title.lastIndexOf('(');
  if (idx === -1 || !title.endsWith(')')) return { main: title, note: null, inlineNote: false };
  return {
    main: title.slice(0, idx).trim(),
    note: title.slice(idx).trim(),
    inlineNote: title.includes('かっぱのキューちゃん'),
  };
}

const characterWorksGrid = characterWorksList.slice(0, 9).map(([title, client], i) => ({
  img: `works_character_${String(i + 1).padStart(2, '0')}.jpg`,
  title,
  client,
}));
---
<Layout
  title="取引実績 | 株式会社イトピック"
  description="式典・イベント、デザイン・印刷、ノベルティ・商品、映像制作のカテゴリ別実績を掲載。茨城県庁をはじめ自治体・企業との豊富な取引実績と、数字で見るイトピックの歩みをご紹介します。"
  ogType="article"
  ogImage={ogImageSrc}
>
<main>

  <!-- PAGE HERO -->
  <section id="page-hero-works"
    class="w-full bg-white relative overflow-hidden"
   
  >
    <div class="hidden md:block absolute inset-y-0 right-0 w-full max-w-[1440px] pointer-events-none select-none left-1/2 -translate-x-1/2 z-0" aria-hidden="true">
      <div class="absolute top-0 right-0 w-[clamp(260px,28vw,420px)] h-[clamp(260px,28vw,420px)] opacity-[0.55]">
        <Image src={ibarakiBg} alt="" class="w-full h-full object-contain object-right-top" />
      </div>
    </div>
    <div class="relative z-10 w-full max-w-[1440px] mx-auto flex flex-col justify-center px-6 md:px-8 lg:px-0 min-h-[clamp(200px,28vw,455px)]">
      <p class="font-inter font-bold text-[#4982C2] tracking-widest mb-4 tracking-[0.18em]"  style="font-size: var(--fs-small);">Our Works</p>
      <h1 data-title-anim class="font-noto font-bold text-[#333333] leading-tight mb-6"  style="font-size: var(--fs-display);">取引実績</h1>
      <nav aria-label="パンくずリスト">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="font-noto font-medium text-[#333333] hover:text-[#004896] transition-colors duration-200"  style="font-size: var(--fs-small);">ホーム</a></li>
          <li class="font-noto font-medium text-[#333333]"  aria-hidden="true" style="font-size: var(--fs-small);">&gt;</li>
          <li class="font-noto font-medium text-[#333333]"  aria-current="page" style="font-size: var(--fs-small);">取引実績</li>
        </ol>
      </nav>
    </div>
  </section>

  <!-- MAIN VISUAL -->
  <div data-mv-parallax class="relative w-full overflow-hidden h-[clamp(240px,40vw,600px)]">
    <Image src={worksMb} alt="取引実績メインビジュアル" loading="eager" class="mv-parallax-img absolute w-full object-cover object-center" />
  </div>

  <!-- HERO 01 -->
  <section id="works-hero-01" class="w-full bg-white flex items-center justify-center py-14 md:py-36">
    <div data-a="fade" class="w-full max-w-[1440px] mx-auto px-6 md:px-8 lg:px-0 flex flex-col items-center justify-center text-center">
      <p class="font-inter font-bold text-[#4982C2] tracking-widest mb-4 md:mb-8 tracking-[0.2em]"  style="font-size: var(--fs-small);">Achievements since 1988</p>
      <h2 class="font-noto font-bold text-[#004896] leading-snug tracking-[0.05em]"  style="font-size: var(--fs-h1);">
        創業以来の歩みと実績
      </h2>
    </div>
</section>

  <!-- HERO 02 -->
  <section id="works-hero-02" class="w-full bg-white">
    <div class="w-full max-w-[1440px] mx-auto px-6 md:px-8 lg:px-0">
      <div class="flex flex-col lg:flex-row lg:items-start gap-fluid-2col pt-0 pb-[var(--sp-section-lg)]">
        <div data-a="fade" class="flex-1 min-w-0">
          <h3 class="font-noto font-bold text-[#333333] leading-normal mb-6 tracking-[0.02em]"  style="font-size: var(--fs-h3);">
            創業以来、変わらぬ姿勢で<br />プロジェクトに向き合ってきました。
          </h3>
          <div class="w-[60px] h-[3px] bg-[#4982C2] mb-8"></div>
          <div class="font-noto font-medium text-[#333333] leading-loose space-y-5"  style="font-size: var(--fs-body-lg);">
            <p>1988年の創業以来、私たちは自治体・県関連団体・民間企業の皆様とともに、地域の魅力を伝える多様なプロジェクトに携わってきました。式典・イベントの企画運営をはじめ、映像制作、デザイン制作、広報支援など、地域のコミュニケーション活動を幅広くサポートしてきた実績があります。</p>
            <p>長年にわたり積み重ねてきた経験と信頼は、私たちの大きな財産です。地域の特性を理解した提案力、丁寧な進行管理、確かな技術力を強みに、これからもお客様の目的に寄り添ったプロジェクトを実現していきます。</p>
            <p>ここでは、直近の代表的な実績をカテゴリ別にご紹介します。掲載内容はクライアントの許諾範囲内での表記となります。</p>
          </div>
        </div>
        <div data-a="fade" class="col-media overflow-hidden rounded-[4px] mt-10 md:mt-0 h-[clamp(280px,38vw,560px)]">
          <Image src={worksMain} alt="創業以来の歩みと実績" class="w-full h-full object-cover object-center" />
        </div>
      </div>
    </div>
  </section>

  <!-- NUMBERS -->
  <section id="works-numbers" class="w-full relative overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <Image src={worksBg} alt="" class="w-full h-full object-cover object-center" />
    </div>
    <div class="relative z-10 w-full max-w-[1440px] mx-auto px-6 md:px-8 lg:px-0 section-lg">
      <div data-a="fade" class="text-left md:text-center mb-16 md:mb-20">
        <p class="font-inter font-bold text-white tracking-widest mb-5 opacity-80 tracking-[0.2em]"  style="font-size: var(--fs-small);">Numbers</p>
        <h2 class="font-noto font-bold text-white leading-tight mb-8"  style="font-size: var(--fs-h2);">数字で見る、これまでの歩み</h2>
        <p class="font-noto font-medium text-white opacity-85 leading-loose text-left md:text-center"  style="font-size: var(--fs-body);">
          創業からの年数、累計取引件数、取引先団体数など、これまでの歩みを数字でご紹介します。
        </p>
      </div>
      <div data-a="stagger" class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-0">
        <div class="flex flex-col px-6 md:px-8 lg:px-12 pb-10 lg:pb-0 lg:border-r lg:border-white lg:border-opacity-25">
          <div class="w-12 h-[2px] bg-white opacity-40 mb-6"></div>
          <p class="font-noto font-medium text-white opacity-75 mb-2 text-center lg:text-left"  style="font-size: var(--fs-body);">創業からの年数</p>
          <p class="font-noto font-medium text-white opacity-55 mb-6 text-center lg:text-left"  style="font-size: var(--fs-caption);">1988年 創業</p>
          <div class="flex items-baseline justify-center lg:justify-start gap-1 mb-8">
            <span class="font-inter font-bold text-white js-counter leading-none mx-1 inline-block min-w-[2ch] tabular-nums text-center" data-target="38" style="font-size: var(--fs-stat);">38</span>
            <span class="font-noto font-bold text-white"  style="font-size: var(--fs-h2);">年</span>
          </div>
          <div class="border border-white border-opacity-40 rounded-[4px] p-5">
            <p class="font-noto font-medium text-white opacity-85 leading-loose"  style="font-size: var(--fs-small);">
              創業から38年。いつの時代も、地域の皆様の大切な式典や行事をすぐそばで全力でサポートしてきました。
            </p>
          </div>
        </div>
        <div class="flex flex-col px-6 md:px-8 lg:px-12 pb-10 lg:pb-0 lg:border-r lg:border-white lg:border-opacity-25">
          <div class="w-12 h-[2px] bg-white opacity-40 mb-6"></div>
          <p class="font-noto font-medium text-white opacity-75 mb-2 text-center lg:text-left"  style="font-size: var(--fs-body);">累計取引件数</p>
          <p class="font-noto font-medium text-white opacity-55 mb-6 text-center lg:text-left"  style="font-size: var(--fs-caption);">自治体・民間企業含む総数</p>
          <div class="flex items-baseline justify-center lg:justify-start gap-1 mb-8">
            <span class="font-inter font-bold text-white"  style="font-size: var(--fs-h2);">約</span>
            <span class="font-inter font-bold text-white js-counter leading-none mx-1" data-target="5500" data-format="comma"
                  style="font-size: var(--fs-stat);">5,500</span>
            <span class="font-noto font-bold text-white"  style="font-size: var(--fs-h2);">件</span>
          </div>
          <div class="border border-white border-opacity-40 rounded-[4px] p-5">
            <p class="font-noto font-medium text-white opacity-85 leading-loose"  style="font-size: var(--fs-small);">
              これまで手がけた豊富な実績数が私たちの誇り。事前準備から当日の進行・運営まで安心してお任せください。
            </p>
          </div>
        </div>
        <div class="flex flex-col px-6 md:px-8 lg:px-12 pb-0">
          <div class="w-12 h-[2px] bg-white opacity-40 mb-6"></div>
          <p class="font-noto font-medium text-white opacity-75 mb-2 text-center lg:text-left"  style="font-size: var(--fs-body);">取引先団体数</p>
          <p class="font-noto font-medium text-white opacity-55 mb-6 text-center lg:text-left"  style="font-size: var(--fs-caption);">自治体・県関連団体・民間企業</p>
          <div class="flex items-baseline justify-center lg:justify-start gap-1 mb-8">
            <span class="font-inter font-bold text-white"  style="font-size: var(--fs-h2);">約</span>
            <span class="font-inter font-bold text-white js-counter leading-none mx-1 inline-block min-w-[3ch] tabular-nums text-center" data-target="320" style="font-size: var(--fs-stat);">320</span>
            <span class="font-noto font-bold text-white"  style="font-size: var(--fs-h2);">団体</span>
          </div>
          <div class="border border-white border-opacity-40 rounded-[4px] p-5">
            <p class="font-noto font-medium text-white opacity-85 leading-loose"  style="font-size: var(--fs-small);">
              自治体・県関連団体をはじめ、多くの取引先の皆様と、信頼のパートナーとして地域の未来へ確かな絆を築いています。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- RATIO -->
  <section id="works-ratio" class="w-full bg-[#F0F6FA] section-lg">
    <div class="w-full max-w-[1440px] mx-auto px-6 md:px-8 lg:px-0">
      <div data-a="fade" class="text-left md:text-center mb-14 md:mb-20">
        <p class="font-inter font-bold text-[#4982C2] tracking-widest mb-5 tracking-[0.2em]"  style="font-size: var(--fs-small);">Data Visualization</p>
        <h2 class="font-noto font-bold text-[#004896] leading-tight mb-8"  style="font-size: var(--fs-h2);">取引先の構成比率</h2>
        <p class="font-noto font-medium text-[#333333] leading-loose text-left md:text-center"  style="font-size: var(--fs-body);">
          県・県関連団体と市町村を合わせた自治体系の取引先が約6割、民間企業が約4割を占めています。<br class="hidden md:block" />
          県庁や市町村、公社、商工会から医療法人まで、多様なクライアントとパートナーシップを築いています。
        </p>
      </div>
      <div data-a="fade" class="flex flex-col lg:flex-row lg:items-center gap-fluid-2col">
        <div class="flex-shrink-0 flex flex-col items-center justify-center w-full min-w-0 max-w-[min(432px,100%)] mx-auto">
          <div class="relative w-full max-w-[400px] aspect-square">
            <svg id="donut-chart" viewBox="0 0 200 200"
                 class="w-full h-full -rotate-90">
              <circle cx="100" cy="100" r="75" fill="none" stroke="#E2E8F0" stroke-width="28" />
              <circle id="seg1" cx="100" cy="100" r="75" fill="none" stroke="#004896" stroke-width="28"
                      stroke-dasharray="0 471" stroke-linecap="butt" data-pct="44" />
              <circle id="seg2" cx="100" cy="100" r="75" fill="none" stroke="#4982C2" stroke-width="28"
                      stroke-dasharray="0 471" stroke-linecap="butt" data-pct="20" data-offset="44" />
              <circle id="seg3" cx="100" cy="100" r="75" fill="none" stroke="#B8C8DC" stroke-width="28"
                      stroke-dasharray="0 471" stroke-linecap="butt" data-pct="36" data-offset="64" />
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <p class="font-inter font-bold text-[#004896] tracking-[0.15em] opacity-60"  style="font-size: var(--fs-caption);">構成比率</p>
              <p class="font-inter font-bold text-[#004896] leading-none my-0.5"  id="donut-center-num" style="font-size: clamp(40px, 3.5vw, 60px);">0</p>
              <p class="font-inter font-bold text-[#004896] opacity-[0.7]"  style="font-size: var(--fs-body);">%</p>
            </div>
          </div>
        </div>
        <div class="flex-1 min-w-0 flex flex-col gap-5 md:max-w-[750px]">
          <div class="bg-white rounded-[8px] px-6 py-5 flex items-center justify-between border-l-4 border-[#004896]">
            <div>
              <p class="font-noto font-bold text-[#004896] mb-1"  style="font-size: var(--fs-body-lg);">県・県関連団体</p>
              <p class="font-noto font-medium text-[#666666]"  style="font-size: var(--fs-caption);">茨城県庁各課・公社など</p>
            </div>
            <div class="flex items-baseline gap-1 flex-shrink-0 ml-4">
              <span class="font-inter font-bold text-[#004896] js-ratio-counter leading-none" data-target="44"
                    style="font-size: var(--fs-stat);">44</span>
              <span class="font-inter font-bold text-[#004896]"  style="font-size: var(--fs-h3);">%</span>
            </div>
          </div>
          <div class="bg-white rounded-[8px] px-6 py-5 flex items-center justify-between border-l-4 border-[#4982C2]">
            <div>
              <p class="font-noto font-bold text-[#4982C2] mb-1"  style="font-size: var(--fs-body-lg);">市町村</p>
              <p class="font-noto font-medium text-[#666666]"  style="font-size: var(--fs-caption);">県内市役所・町村役場・商工会など</p>
            </div>
            <div class="flex items-baseline gap-1 flex-shrink-0 ml-4">
              <span class="font-inter font-bold text-[#4982C2] js-ratio-counter leading-none" data-target="20"
                    style="font-size: var(--fs-stat);">20</span>
              <span class="font-inter font-bold text-[#4982C2]"  style="font-size: var(--fs-h3);">%</span>
            </div>
          </div>
          <div class="bg-white rounded-[8px] px-6 py-5 flex items-center justify-between border-l-4 border-[#B8C8DC]">
            <div>
              <p class="font-noto font-bold text-[#333333] mb-1"  style="font-size: var(--fs-body-lg);">民間企業</p>
              <p class="font-noto font-medium text-[#666666]"  style="font-size: var(--fs-caption);">民間企業・主要団体・医療法人など</p>
            </div>
            <div class="flex items-baseline gap-1 flex-shrink-0 ml-4">
              <span class="font-inter font-bold text-[#333333] js-ratio-counter leading-none" data-target="36"
                    style="font-size: var(--fs-stat);">36</span>
              <span class="font-inter font-bold text-[#333333]"  style="font-size: var(--fs-h3);">%</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WORKS LIST -->
  <section id="works-list" class="w-full bg-white pt-[var(--sp-section-lg)] pb-[var(--sp-section-sm)]">
    <div class="w-full max-w-[1440px] mx-auto px-6 md:px-8 lg:px-0">
      <div data-a="fade" class="text-left md:text-center mb-12 md:mb-16">
        <p class="font-inter font-bold text-[#4982C2] tracking-widest mb-5 tracking-[0.2em]"  style="font-size: var(--fs-small);">Works</p>
        <h2 class="font-noto font-bold text-[#004896] leading-tight mb-8"  style="font-size: var(--fs-h2);">カテゴリ別 実績一覧</h2>
        <p class="font-noto font-medium text-[#333333] leading-loose text-left md:text-center"  style="font-size: var(--fs-body);">
          これまでの代表的な実績と、直近の掲載可能な実績一覧です。<br class="hidden md:block" />
          サービスカテゴリを選んでご覧ください。
        </p>
      </div>

      <!-- タブナビ -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 mb-[58px] border border-[#D1D1D1] md:border-0 lg:border divide-x divide-[#D1D1D1]" id="works-tab-nav">
        <button onclick="worksShowTab('event', this)"
                class="works-tab-btn active flex flex-col items-center text-center px-0 pb-0
                       font-noto font-medium text-[#004896] whitespace-nowrap transition-colors duration-200 pt-[0.7rem]">
          <span class="font-inter text-[#4982C2] mb-1 tracking-[0.12em]"  style="font-size: 10px;">Event</span>
          イベント
          <span class="block mt-[10px] mx-3 h-[3px] w-full bg-[#004896] rounded-full transition-all duration-200"></span>
        </button>
        <button onclick="worksShowTab('ceremony', this)"
                class="works-tab-btn flex flex-col items-center text-center px-0 pb-0
                       font-noto font-medium text-[#999] whitespace-nowrap transition-colors duration-200 hover:text-[#004896] pt-[0.7rem]">
          <span class="font-inter text-[#4982C2] mb-1 tracking-[0.12em]"  style="font-size: 10px;">ceremony</span>
          式典
          <span class="block mt-[10px] mx-3 h-[3px] w-full bg-[#D1D1D1] rounded-full transition-all duration-200"></span>
        </button>
