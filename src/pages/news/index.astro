---
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import { getAllNews, formatDate, formatDatetime } from '../../lib/microcms';
import ibarakiBg from '../../assets/images/ibaraki_bg.png';
import newsMb from '../../assets/images/news_mb.png';

const { contents: newsItems } = await getAllNews();
const ogImageSrc = (await getImage({ src: newsMb, width: 1200 })).src;

const categoryColors: Record<string, string> = {
  'お知らせ': 'border-[#004896] text-[#004896]',
  '実績':     'border-[#004896] text-[#004896]',
  '新着情報': 'border-[#004896] text-[#004896]',
};
---
<Layout
  title="お知らせ | 株式会社イトピック"
  description="株式会社イトピック（茨城県水戸市）からの最新情報・実績・新着情報をカテゴリ別に掲載。式典・イベントや自治体向けクリエイティブに関するニュースや更新情報をご覧いただけます。"
  ogType="article"
  ogImage={ogImageSrc}
>
<main>

  <section
    id="page-hero-news"
    class="w-full bg-white relative overflow-hidden max-h-[455px] min-h-[clamp(200px,28vw,455px)]"
  >
    <div
      class="hidden md:block absolute inset-y-0 right-0 w-full max-w-[1440px] pointer-events-none select-none left-1/2 -translate-x-1/2 z-0"
      aria-hidden="true"
    >
      <div class="absolute top-0 right-0 w-[clamp(260px,28vw,420px)] h-[clamp(260px,28vw,420px)] opacity-[0.55]">
        <Image src={ibarakiBg} alt="" class="w-full h-full object-contain object-right-top" />
      </div>
    </div>
    <div class="relative z-10 w-full max-w-[1440px] mx-auto flex flex-col justify-center px-6 md:px-8 lg:px-0 min-h-[clamp(200px,28vw,455px)]">
      <p class="font-inter font-bold text-[#4982C2] tracking-[0.18em] mb-4"  style="font-size: var(--fs-small);">News</p>
      <h1 data-title-anim class="font-noto font-bold text-[#333333] leading-tight mb-6"  style="font-size: var(--fs-display);">お知らせ</h1>
      <nav aria-label="パンくずリスト">
        <ol class="flex items-center gap-2 flex-wrap">
          <li>
            <a href="/" class="font-noto font-medium text-[#333333] hover:text-[#004896] transition-colors duration-200"  style="font-size: var(--fs-small);">ホーム</a>
          </li>
          <li class="font-noto font-medium text-[#333333]"  aria-hidden="true" style="font-size: var(--fs-small);">&gt;</li>
          <li class="font-noto font-medium text-[#333333]"  aria-current="page" style="font-size: var(--fs-small);">お知らせ</li>
        </ol>
      </nav>
    </div>
  </section>

  <div data-mv-parallax class="relative w-full overflow-hidden h-[clamp(240px,40vw,600px)]">
    <Image src={newsMb} alt="お知らせメインビジュアル"
           loading="eager"
           class="mv-parallax-img absolute w-full object-cover object-center" />
  </div>

  <section id="news-list" class="w-full bg-white section-lg lg:pb-[clamp(160px,12vw,240px)]">
    <div class="w-full max-w-[1440px] mx-auto px-6 md:px-8 lg:px-0">

      <div data-a="fade" class="mb-12 md:mb-16">
        <p class="font-inter font-bold text-[#4982C2] tracking-[0.18em] mb-4"  style="font-size: var(--fs-small);">Latest News</p>
        <h2 class="font-noto font-bold text-[#004896] leading-tight"  style="font-size: var(--fs-h2);">お知らせ</h2>
      </div>

      <div data-a="fade" class="flex flex-wrap items-center gap-3 mb-10 md:mb-14" role="list" aria-label="カテゴリ絞り込み">
        {[
          { filter: 'all', label: 'すべて', active: true },
          { filter: 'お知らせ', label: 'お知らせ', active: false },
          { filter: '実績', label: '実績', active: false },
          { filter: '新着情報', label: '新着情報', active: false },
        ].map((btn) => (
          <button
            type="button"
            data-filter={btn.filter}
            class:list={[
              'filter-btn font-noto font-medium px-5 py-2 rounded-full border border-[#004896] transition-colors duration-200' ,
              btn.active
                ? 'active text-white bg-[#004896]'
                : 'text-[#004896] bg-white hover:bg-[#004896] hover:text-white',
            ]}
           style="font-size: var(--fs-caption);">
            {btn.label}
          </button>
        ))}
      </div>

      <div id="news-list-items" class="border-t border-[#E0E6EF]">
        {newsItems.map((item) => (
          <article data-a="fade" class="news-article" data-category={item.category}>
            <a
              href={`/news/${item.id}`}
              class="group flex flex-col md:flex-row md:items-center gap-3 md:gap-6 py-8 md:py-10 border-b border-[#E0E6EF] hover:opacity-75 transition-opacity duration-200"
            >
              <time
                datetime={formatDatetime(item.publishedAt)}
                class="font-inter font-bold text-[#004896] flex-shrink-0 whitespace-nowrap" 
               style="font-size: var(--fs-small);">
                {formatDate(item.publishedAt)}
              </time>

              <span
                class:list={[
                  'flex-shrink-0 font-noto font-medium border px-3 py-0.5 text-center whitespace-nowrap rounded-[2px] min-w-[80px]' ,
                  categoryColors[item.category] ?? 'border-[#999] text-[#999]',
                ]}
               style="font-size: 12px;">
                {item.category}
              </span>

              <p class="font-noto font-medium text-[#333333] leading-relaxed flex-1 min-w-0"  style="font-size: var(--fs-body);">
                {item.title}
              </p>

              <span class="hidden md:flex flex-shrink-0 w-9 h-9 rounded-full border border-[#004896] items-center justify-center text-[#004896] ml-auto group-hover:bg-[#004896] group-hover:text-white transition-colors duration-200">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="w-4 h-4">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </span>
            </a>
          </article>
        ))}
      </div>

      <p id="news-empty"
         class="hidden font-noto font-medium text-[#999] text-center py-20"  style="font-size: var(--fs-body);">
        該当するお知らせはありません。
      </p>

      <nav id="news-pagination" aria-label="ページナビゲーション" class="hidden items-center justify-center gap-2 mt-16"></nav>

    </div>
  </section>

  <ContactSection />

</main>
</Layout>

<script>
  const NEWS_PER_PAGE = 10;

  function initNewsList() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const articles = document.querySelectorAll<HTMLElement>('.news-article');
    const empty = document.getElementById('news-empty');
    const pagination = document.getElementById('news-pagination');
    const listSection = document.getElementById('news-list');

    if (!filterBtns.length || !articles.length || !pagination) return;

    let currentFilter = 'all';
    let currentPage = 1;

    function getMatchedArticles(): HTMLElement[] {
      return Array.from(articles).filter(function (article) {
        const cat = article.getAttribute('data-category') ?? '';
        return currentFilter === 'all' || cat === currentFilter;
      });
    }

    function renderPagination(totalPages: number) {
      pagination.innerHTML = '';

      if (totalPages <= 1) {
        pagination.classList.add('hidden');
        pagination.classList.remove('flex');
        return;
      }

      pagination.classList.remove('hidden');
      pagination.classList.add('flex');

      const prevBtn = document.createElement('button');
      prevBtn.type = 'button';
      prevBtn.setAttribute('aria-label', '前のページ');
      prevBtn.className = currentPage <= 1
        ? 'w-10 h-10 flex items-center justify-center rounded-[4px] border border-[#E0E6EF] text-[#CCCCCC] cursor-not-allowed'
        : 'w-10 h-10 flex items-center justify-center rounded-[4px] border border-[#E0E6EF] text-[#333333] hover:border-[#004896] hover:text-[#004896] transition-colors duration-200';
      prevBtn.disabled = currentPage <= 1;
      prevBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><polyline points="15 18 9 12 15 6"></polyline></svg>';
      if (currentPage > 1) {
        prevBtn.addEventListener('click', function () {
          currentPage -= 1;
          renderList(true);
        });
      }
      pagination.appendChild(prevBtn);

      for (let page = 1; page <= totalPages; page += 1) {
        const pageBtn = document.createElement('button');
        pageBtn.type = 'button';
        pageBtn.textContent = String(page);
        pageBtn.setAttribute('aria-label', page + 'ページ目');
        pageBtn.style.fontSize = '14px';

        if (page === currentPage) {
          pageBtn.className = 'w-10 h-10 flex items-center justify-center rounded-[4px] border border-[#004896] bg-[#004896] text-white font-inter font-bold';
          pageBtn.setAttribute('aria-current', 'page');
        } else {
          pageBtn.className = 'w-10 h-10 flex items-center justify-center rounded-[4px] border border-[#E0E6EF] text-[#333333] font-inter font-bold hover:border-[#004896] hover:text-[#004896] transition-colors duration-200';
          pageBtn.addEventListener('click', function () {
            currentPage = page;
            renderList(true);
          });
        }

        pagination.appendChild(pageBtn);
      }

      const nextBtn = document.createElement('button');
      nextBtn.type = 'button';
      nextBtn.setAttribute('aria-label', '次のページ');
      nextBtn.className = currentPage >= totalPages
        ? 'w-10 h-10 flex items-center justify-center rounded-[4px] border border-[#E0E6EF] text-[#CCCCCC] cursor-not-allowed'
        : 'w-10 h-10 flex items-center justify-center rounded-[4px] border border-[#E0E6EF] text-[#333333] hover:border-[#004896] hover:text-[#004896] transition-colors duration-200';
      nextBtn.disabled = currentPage >= totalPages;
      nextBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><polyline points="9 18 15 12 9 6"></polyline></svg>';
      if (currentPage < totalPages) {
        nextBtn.addEventListener('click', function () {
          currentPage += 1;
          renderList(true);
        });
      }
      pagination.appendChild(nextBtn);
    }

    function renderList(scrollToTop: boolean) {
      const matched = getMatchedArticles();
      const totalPages = Math.max(1, Math.ceil(matched.length / NEWS_PER_PAGE));

      if (currentPage > totalPages) currentPage = totalPages;

      articles.forEach(function (article) {
        article.style.display = 'none';
      });

      matched.forEach(function (article, index) {
        const page = Math.floor(index / NEWS_PER_PAGE) + 1;
        if (page === currentPage) {
          article.style.display = '';
        }
      });

      if (empty) {
        empty.classList.toggle('hidden', matched.length > 0);
      }

      renderPagination(totalPages);

      if (scrollToTop && listSection) {
        listSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    filterBtns.forEach(function (btn) {
      if (btn.dataset.filterBound === 'true') return;
      btn.dataset.filterBound = 'true';
      btn.addEventListener('click', function () {
        currentFilter = btn.getAttribute('data-filter') ?? 'all';
        currentPage = 1;

        filterBtns.forEach(function (b) {
          b.classList.remove('active', 'text-white', 'bg-[#004896]');
          b.classList.add('text-[#004896]', 'bg-white');
        });
        btn.classList.remove('text-[#004896]', 'bg-white');
        btn.classList.add('active', 'text-white', 'bg-[#004896]');

        renderList(false);
      });
    });

    renderList(false);
  }

  document.addEventListener('astro:page-load', initNewsList);
</script>
