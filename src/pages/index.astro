---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { SITE_ORIGIN } from '../consts/site';
import { getLatestNews, formatDate, formatDatetime } from '../lib/microcms';
import mbBg from '../assets/images/mb_bg.jpg';
import mb01 from '../assets/images/mb_01.jpg';
import mb02 from '../assets/images/mb_02.png';
import mb03 from '../assets/images/mb_03.jpg';
import ibarakiMap from '../assets/images/ibaraki-map.png';
import servicesMain from '../assets/images/services_main.JPG';
import services301 from '../assets/images/services_3_01.jpg';
import services302 from '../assets/images/services_3_02.png';
import services303 from '../assets/images/services_3_03.jpg';
import worksBg from '../assets/images/works_bg.jpg';
import koumon from '../assets/images/koumon.jpg';
import oneStop from '../assets/images/one-stop.png';
import companyMain from '../assets/images/company_main.jpg';
import contactBg from '../assets/images/contact_bg.png';

const latestNews = await getLatestNews(3);

const description =
  '茨城県水戸市の株式会社イトピック公式サイト。創業38年超の実績で式典・イベントの企画運営から映像制作・デザイン・ノベルティまで、自治体・県関連団体向けクリエイティブをワンストップでご提供します。';

const siteUrl = `${SITE_ORIGIN}/`;
const logoUrl = `${SITE_ORIGIN}/images/itpc-logo.svg`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: '株式会社イトピック',
  description,
  url: siteUrl,
  logo: logoUrl,
  image: logoUrl,
  telephone: '029-253-4387',
  address: {
    '@type': 'PostalAddress',
    postalCode: '311-4163',
    addressRegion: '茨城県',
    addressLocality: '水戸市',
    streetAddress: '加倉井町341-6',
    addressCountry: 'JP',
  },
};
---
<Layout
  title="株式会社 イトピック | ITPIC"
  description={description}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

<main data-page="index">

  <!-- =============================================
       HERO / MAIN VISUAL
  ============================================== -->
  <section
    id="hero"
    class="relative w-full overflow-hidden min-h-[600px] max-h-[1200px]"
    aria-label="メインビジュアル"
  >
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <Image src={mbBg} alt="" class="w-full h-full object-cover object-center" />
    </div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(8,20,55,0.92)_0%,rgba(8,20,55,0.82)_35%,rgba(8,20,55,0.55)_58%,rgba(8,20,55,0.10)_100%)]" aria-hidden="true"></div>

    <div
      class="relative z-10 w-full flex flex-col lg:flex-row items-start lg:items-stretch px-6 md:px-8 lg:pl-[60px] lg:pr-0 min-h-[600px] max-h-[1200px] gap-0"
    >
      <!-- LEFT -->
      <div
        class="w-full flex flex-col justify-center py-12 md:py-16 lg:py-20 xl:py-28 lg:flex-[0_0_55%] min-w-0"
      >
        <p
          class="font-inter font-bold text-[#4982C2] mb-6 md:mb-8 tracking-[3px]" 
         style="font-size: var(--fs-body-lg);">
          Event Planning &amp; Production
        </p>
        <h1
          class="font-noto font-bold text-white leading-loose mb-8 md:mb-10 w-full tracking-[2.05px]" 
         style="font-size: var(--fs-display);">
          <span class="text-[#4982C2]">38年超</span>の実績と創造力で、<br class="hidden md:block" />茨城の魅力を次世代へ。
        </h1>
        <div
          class="font-noto font-medium text-white mb-10 md:mb-14 space-y-1 leading-[2.0] tracking-[1.15px]" 
         style="font-size: var(--fs-body-lg);">
          <p>茨城の魅力発信と地域活性化に、</p>
          <p>長年取り組んできました。</p>
          <p>培ってきた確かな技術で、</p>
          <p>安心・安全なクリエイティブを提供します。</p>
        </div>
        <div>
          <a
            href="/contact"
            class="font-noto font-bold text-white bg-[#4982C2] hover:bg-[#3a6eaa] transition-colors duration-300 inline-flex items-center justify-center gap-3 w-[80%] max-w-[280px] md:max-w-[320px] lg:w-[80%] lg:max-w-[438px] rounded-[32px] py-4 px-8" 
           style="font-size: var(--fs-body);">
            ご相談窓口はこちら
            <span class="font-inter font-bold text-xl">→</span>
          </a>
        </div>
      </div>

      <!-- RIGHT: 縦スクロール画像 (PC) -->
      <div
        class="hidden lg:flex items-start self-stretch overflow-hidden pr-[80px] flex-[1_1_0%] min-w-0 pl-0"
        aria-hidden="true"
      >
        <div
          class="marquee-track flex flex-col gap-[60px] pt-4 pb-4 w-full animate-marquee-vertical"
        >
          <div class="w-full overflow-hidden">
            <Image src={mb01} alt="実績写真1" class="object-cover w-full h-auto" />
          </div>
          <div class="w-full overflow-hidden">
            <Image src={mb02} alt="実績写真2" class="object-cover w-full h-auto" />
          </div>
          <div class="w-full overflow-hidden">
            <Image src={mb03} alt="実績写真3" class="object-cover w-full h-auto" />
          </div>
          <div class="w-full overflow-hidden">
            <Image src={mb01} alt="" class="object-cover w-full h-auto" aria-hidden="true" />
          </div>
          <div class="w-full overflow-hidden">
            <Image src={mb02} alt="" class="object-cover w-full h-auto" aria-hidden="true" />
          </div>
          <div class="w-full overflow-hidden">
            <Image src={mb03} alt="" class="object-cover w-full h-auto" aria-hidden="true" />
          </div>
        </div>
      </div>

      <!-- SP: 自動横マーキー（右→左 無限スクロール） -->
      <div class="lg:hidden w-full overflow-hidden pb-8 pt-4" aria-hidden="true">
        <div class="flex gap-4 w-max animate-[marquee-horizontal_14s_linear_infinite]">
          <!-- オリジナル3枚 -->
          <div class="flex-shrink-0 overflow-hidden rounded-lg w-[42vw] max-w-[200px] md:w-[28vw] md:max-w-[280px] aspect-[4/3]" >
            <Image src={mb01} alt="実績写真1" class="object-cover w-full h-full" />
          </div>
          <div class="flex-shrink-0 overflow-hidden rounded-lg w-[42vw] max-w-[200px] md:w-[28vw] md:max-w-[280px] aspect-[4/3]" >
            <Image src={mb02} alt="実績写真2" class="object-cover w-full h-full" />
          </div>
          <div class="flex-shrink-0 overflow-hidden rounded-lg w-[42vw] max-w-[200px] md:w-[28vw] md:max-w-[280px] aspect-[4/3]" >
            <Image src={mb03} alt="実績写真3" class="object-cover w-full h-full" />
          </div>
          <!-- 複製3枚（シームレスループ用） -->
          <div class="flex-shrink-0 overflow-hidden rounded-lg w-[42vw] max-w-[200px] md:w-[28vw] md:max-w-[280px] aspect-[4/3]" >
            <Image src={mb01} alt="" class="object-cover w-full h-full" />
          </div>
          <div class="flex-shrink-0 overflow-hidden rounded-lg w-[42vw] max-w-[200px] md:w-[28vw] md:max-w-[280px] aspect-[4/3]" >
            <Image src={mb02} alt="" class="object-cover w-full h-full" />
          </div>
          <div class="flex-shrink-0 overflow-hidden rounded-lg w-[42vw] max-w-[200px] md:w-[28vw] md:max-w-[280px] aspect-[4/3]" >
            <Image src={mb03} alt="" class="object-cover w-full h-full" />
          </div>
        </div>
      </div>

    </div>
  </section>
  <!-- /HERO -->


  <!-- =============================================
       SERVICES SECTION
  ============================================== -->
  <section id="services" class="w-full bg-[#F0F6FA] overflow-hidden">

    <div class="relative max-w-[1440px] mx-auto px-6 md:px-8 lg:pl-0 lg:pr-[120px] pt-[var(--sp-section-lg)] pb-[var(--sp-section-sm)]">

      <div class="hidden lg:block absolute top-20 right-0 pointer-events-none w-[min(528px,36vw)] h-[min(552px,38vw)] z-0">
        <Image src={ibarakiMap} alt="" class="w-full h-full object-contain" aria-hidden="true" />
        <div class="absolute top-[53%] left-[65%]" >
          <span class="absolute rounded-full border border-[#4982C2] w-[100px] h-[100px] -top-[45px] -left-[45px] ripple-1"></span>
          <span class="absolute rounded-full border border-[#4982C2] w-[100px] h-[100px] -top-[45px] -left-[45px] ripple-2"></span>
          <span class="absolute rounded-full border border-[#4982C2] w-[100px] h-[100px] -top-[45px] -left-[45px] ripple-3"></span>
          <span class="relative flex h-3 w-3 -mt-[1.5px] -ml-[1.5px]" >
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#4982C2] opacity-70"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-[#004896] border border-white"></span>
          </span>
        </div>
      </div>

      <div class="relative z-10 w-full max-w-full lg:max-w-[1030px]">
        <p class="font-inter font-bold text-[#4982C2] mb-5 tracking-widest"  style="font-size: var(--fs-small);">
          Our Services
        </p>
        <h2 class="font-noto font-bold text-[#004896] leading-tight mb-7"  style="font-size: var(--fs-h1);">
          確かな実現力とサービス
        </h2>
        <p class="font-noto font-medium text-[#333333] leading-loose mb-10"  style="font-size: var(--fs-body-lg);">
          株式会社イトピックでは、式典・イベントの企画運営を中心に、映像制作・デザイン制作・ノベルティ手配まで、プロジェクトに必要な幅広いクリエイティブをワンストップでご提供しています。
        </p>
        <a href="/service"
           class="group font-noto font-medium text-white inline-flex items-center gap-3 px-8 py-4 rounded-[15px] transition-opacity duration-300 hover:opacity-90 bg-[linear-gradient(to_right,#4982C2,#004896)]"  style="font-size: var(--fs-body);">
          業務内容はこちら
          <span class="font-inter font-bold inline-block transition-transform duration-300 group-hover:translate-x-2">→</span>
        </a>
      </div>
    </div>

    <!-- 中央：メインサービス（写真＋青ボックス） -->
    <div class="w-full relative overflow-visible mb-[var(--sp-section-md)]"
         data-service-hero
         >
      <div class="flex flex-col lg:grid lg:items-center overflow-visible lg:grid-cols-[7fr_5fr]">
        <div class="w-full overflow-hidden h-[clamp(300px,42vw,756px)]" >
          <Image src={servicesMain} alt="式典・イベントの企画運営" class="w-full h-full object-cover object-center" data-service-hero-img />
        </div>
        <div class="w-full bg-[#004896] flex flex-col justify-center
                    px-6 py-12 md:px-10 md:py-14 lg:pl-14 lg:pr-[8vw] lg:py-16 lg:-ml-[6%] relative z-10
                    rounded-none lg:rounded-l-[18px] min-h-[clamp(240px,32vw,560px)]"
             data-service-hero-box
             id="services-blue-box">
          <div class="hidden lg:block absolute inset-y-0 bg-[#004896] -z-10 pointer-events-none left-[18px] right-[calc(-1*(100vw-100%)/2-2px)]"></div>
          <p class="font-inter font-bold text-[#4982C2] tracking-widest mb-4 tracking-[3px]"  style="font-size: var(--fs-caption);">
            Main Service
          </p>
          <h3 class="font-noto font-bold text-white leading-normal mb-5"  style="font-size: var(--fs-h3);">
            式典・イベントの、<br />企画から運営までサポート。
          </h3>
          <div class="w-10 h-[2px] bg-[#4982C2] mb-6"></div>
          <p class="font-noto font-medium text-white leading-loose"  style="font-size: var(--fs-body);">
            自治体・県関連団体向けのイベント企画から運営まで、創業からの実績とノウハウで確かなサポートを提供します。記念式典、周年行事、地域イベントなど、あらゆる規模のプロジェクトに対応します。
          </p>
        </div>
      </div>
    </div>

    <!-- 下部：3カラム・サービスカード -->
    <div class="max-w-[1440px] mx-auto px-6 md:px-8 pb-0 mt-[var(--sp-section-lg)]">
      <h3 class="font-noto font-bold text-[#004896] text-center mb-[var(--sp-gap-lg)]"  style="font-size: var(--fs-h3);">
  式典・イベントに合わせて<br class="lg:hidden" />ご提供するサービス。
</h3>


      <!-- PC cards -->
      <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-fluid-related max-w-full" data-card-row>
        <a href="/service#design"
           data-fade
           class="group rounded-[15px] overflow-hidden flex flex-col min-w-0 w-full bg-[#004896] md:h-auto lg:h-[clamp(400px,38vw,515px)]">
          <div class="relative overflow-hidden shrink-0 flex-1 min-h-0 md:flex-none md:h-[clamp(280px,35vw,380px)] lg:flex-1 lg:min-h-0" >
            <Image src={services301} alt="デザイン・印刷" class="w-full h-full object-cover object-center scale-[1.35] origin-center transition-transform duration-500 group-hover:scale-110" />
            <div class="absolute inset-0 bg-gradient-to-b from-[rgba(0,40,110,0.68)] via-[rgba(0,40,110,0.15)] to-transparent p-5">
              <p class="font-noto font-medium text-white leading-relaxed"   style="font-size: var(--fs-small);">
                招待状、パンフレット、看板など、イベントに必要な各種デザイン・印刷物を制作します。
              </p>
            </div>
          </div>
          <div class="flex items-center justify-between px-5 py-3 md:py-2.5 lg:py-4 shrink-0 rounded-b-[15px] bg-[#004896] group-hover:bg-[#003a7a] transition-colors duration-300">
            <div>
              <p class="font-noto font-medium text-[#4982C2] mb-0.5 lg:mb-1"   style="font-size: var(--fs-small);">視覚で伝えるデザインと品質</p>
              <p class="font-noto font-bold text-white"   style="font-size: var(--fs-h4);">デザイン・印刷</p>
            </div>
            <div class="w-10 h-10 rounded-full border border-white flex items-center justify-center shrink-0 overflow-hidden">
              <span class="font-inter font-bold text-white text-sm inline-block transition-transform duration-300 group-hover:translate-x-2">→</span>
            </div>
          </div>
        </a>

        <a href="/service#novelty"
           data-fade
           class="group rounded-[15px] overflow-hidden flex flex-col min-w-0 w-full bg-[#004896] md:h-auto lg:h-[clamp(400px,38vw,515px)]">
          <div class="relative overflow-hidden shrink-0 flex-1 min-h-0 md:flex-none md:h-[clamp(280px,35vw,380px)] lg:flex-1 lg:min-h-0" >
            <Image src={services302} alt="ノベルティ・商品" class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-b from-[rgba(0,40,110,0.68)] via-[rgba(0,40,110,0.15)] to-transparent p-5">
              <p class="font-noto font-medium text-white leading-relaxed"   style="font-size: var(--fs-small);">
                記念品や配布物など、イベントの印象を残すノベルティをご提案します。
              </p>
            </div>
          </div>
          <div class="flex items-center justify-between px-5 py-3 md:py-2.5 lg:py-4 shrink-0 rounded-b-[15px] bg-[#004896] group-hover:bg-[#003a7a] transition-colors duration-300">
            <div>
              <p class="font-noto font-medium text-[#4982C2] mb-0.5 lg:mb-1"   style="font-size: var(--fs-small);">記憶に残るオリジナルグッズと価値</p>
              <p class="font-noto font-bold text-white"   style="font-size: var(--fs-h4);">ノベルティ・商品</p>
            </div>
            <div class="w-10 h-10 rounded-full border border-white flex items-center justify-center shrink-0 overflow-hidden">
              <span class="font-inter font-bold text-white text-sm inline-block transition-transform duration-300 group-hover:translate-x-2">→</span>
            </div>
          </div>
        </a>

        <a href="/service#video"
           data-fade
           class="group rounded-[15px] overflow-hidden flex flex-col min-w-0 w-full bg-[#004896] md:h-auto lg:h-[clamp(400px,38vw,515px)]">
          <div class="relative overflow-hidden shrink-0 flex-1 min-h-0 md:flex-none md:h-[clamp(280px,35vw,380px)] lg:flex-1 lg:min-h-0" >
            <Image src={services303} alt="映像制作" class="w-full h-full object-cover object-[50%_30%] transition-transform duration-500 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-b from-[rgba(0,40,110,0.68)] via-[rgba(0,40,110,0.15)] to-transparent p-5">
              <p class="font-noto font-medium text-white leading-relaxed"   style="font-size: var(--fs-small);">
                式典やイベントの記録映像から企業PR映像まで、目的に合わせた映像制作をご提供します。
              </p>
            </div>
          </div>
          <div class="flex items-center justify-between px-5 py-3 md:py-2.5 lg:py-4 shrink-0 rounded-b-[15px] bg-[#004896] group-hover:bg-[#003a7a] transition-colors duration-300">
            <div>
              <p class="font-noto font-medium text-[#4982C2] mb-0.5 lg:mb-1"   style="font-size: var(--fs-small);">イベントを未来へつなぐ記録</p>
              <p class="font-noto font-bold text-white"   style="font-size: var(--fs-h4);">映像制作</p>
            </div>
            <div class="w-10 h-10 rounded-full border border-white flex items-center justify-center shrink-0 overflow-hidden">
              <span class="font-inter font-bold text-white text-sm inline-block transition-transform duration-300 group-hover:translate-x-2">→</span>
            </div>
          </div>
        </a>
      </div>

      <!-- SP/MD cards -->
      <div class="md:hidden grid grid-cols-1 gap-8 justify-items-center w-full">
        <!-- カード全体の高さを400pxに変更 -->
        <a href="/service#design"
           class="group rounded-[15px] overflow-hidden flex flex-col w-full max-w-[430px] h-[400px]">
          <!-- 画像エリアの高さを300pxに変更 -->
         <div class="relative overflow-hidden shrink-0 h-[300px]" >
  <!-- クラスから w-full h-full object-cover を削除し、styleで確実に130%拡大させて左上に固定しました -->
  <Image src={services301} alt="デザイン・印刷" class="w-[130%] h-[130%] object-cover object-[0%_0%] transition-transform duration-500 group-hover:scale-110" />
  <div class="absolute inset-0 bg-gradient-to-b from-[rgba(0,40,110,0.68)] via-transparent to-transparent p-5">
    <p class="font-noto font-medium text-white leading-relaxed"   style="font-size: var(--fs-small);">招待状、パンフレット、看板など、イベントに必要な各種デザイン・印刷物を制作します。</p>
  </div>
</div>


          <div class="bg-[#004896] group-hover:bg-[#003a7a] transition-colors duration-300 flex items-center justify-between px-5 flex-1">
            <div>
              <p class="font-noto font-medium text-[#4982C2] mb-1"   style="font-size: var(--fs-small);">視覚で伝えるデザインと品質</p>
              <p class="font-noto font-bold text-white"   style="font-size: var(--fs-h3);">デザイン・印刷</p>
            </div>
            <div class="w-10 h-10 rounded-full border border-white flex items-center justify-center">
              <span class="font-inter font-bold text-white text-sm inline-block transition-transform duration-300 group-hover:translate-x-2">→</span>
            </div>
          </div>
        </a>
        
        <!-- カード全体の高さを400pxに変更 -->
        <a href="/service#novelty"
           class="group rounded-[15px] overflow-hidden flex flex-col w-full max-w-[430px] h-[400px]">
          <!-- 画像エリアの高さを300pxに変更 -->
          <div class="relative overflow-hidden shrink-0 h-[300px]" >
            <Image src={services302} alt="ノベルティ・商品" class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-b from-[rgba(0,40,110,0.68)] via-transparent to-transparent p-5">
              <p class="font-noto font-medium text-white leading-relaxed"   style="font-size: var(--fs-small);">記念品や配布物など、イベントの印象を残すノベルティをご提案します。</p>
            </div>
          </div>
          <div class="bg-[#004896] group-hover:bg-[#003a7a] transition-colors duration-300 flex items-center justify-between px-5 flex-1">
            <div>
              <p class="font-noto font-medium text-[#4982C2] mb-1"   style="font-size: var(--fs-small);">記憶に残るオリジナルグッズと価値</p>
              <p class="font-noto font-bold text-white"   style="font-size: var(--fs-h3);">ノベルティ・商品</p>
            </div>
            <div class="w-10 h-10 rounded-full border border-white flex items-center justify-center">
              <span class="font-inter font-bold text-white text-sm inline-block transition-transform duration-300 group-hover:translate-x-2">→</span>
            </div>
          </div>
        </a>
        
        <!-- カード全体の高さを400pxに変更 -->
        <a href="/service#video"
           class="group rounded-[15px] overflow-hidden flex flex-col w-full max-w-[430px] h-[400px]">
          <!-- 画像エリアの高さを300pxに変更 -->
          <div class="relative overflow-hidden shrink-0 h-[300px]" >
            <Image src={services303} alt="映像制作" class="w-full h-full object-cover object-[50%_30%] transition-transform duration-500 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-b from-[rgba(0,40,110,0.68)] via-transparent to-transparent p-5">
              <p class="font-noto font-medium text-white leading-relaxed"   style="font-size: var(--fs-small);">式典やイベントの記録映像から企業PR映像まで、目的に合わせた映像制作をご提供します。</p>
