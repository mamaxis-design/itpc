<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function killIndexScrollTriggers() {
    const root = document.querySelector<HTMLElement>('[data-page="index"]');
    if (!root) return;
    ScrollTrigger.getAll().forEach(function(st) {
      const t = st.trigger as Element | null;
      if (!t || !root.contains(t)) return;
      // Layout.astro が管理するアニメーションは破棄しない（#contact グリッドリビール等）
      if (
        t.id === 'contact' ||
        t.matches('[data-a="fade"], [data-a="stagger"]') ||
        t.hasAttribute('data-mv-parallax')
      ) return;
      st.kill();
    });
  }

  function initIndexAnimations() {
    if (!document.querySelector('[data-page="index"]')) return;
    killIndexScrollTriggers();

    // ── カウンターアニメーション ──────────────────────
    function animateCounter(el: HTMLElement) {
      const target = parseInt((el as HTMLElement & { dataset: { target: string; format?: string } }).dataset.target, 10);
      const isComma = (el as HTMLElement & { dataset: { format?: string } }).dataset.format === 'comma';
      const duration = 1800;
      const start = performance.now();
      function format(n: number) {
        return isComma ? Math.floor(n).toLocaleString('ja-JP') : Math.floor(n).toString();
      }
      function step(now: number) {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const ease = 1 - Math.pow(1 - progress, 4);
        el.textContent = format(target * ease);
        if (progress < 1) requestAnimationFrame(step);
        else el.textContent = format(target);
      }
      requestAnimationFrame(step);
    }
    document.querySelectorAll<HTMLElement>('.js-counter').forEach(function(el) {
      ScrollTrigger.create({
        trigger: el,
        start: 'top 85%',
        once: true,
        onEnter: function() { animateCounter(el); },
      });
    });

    // ── メインサービス：写真（左→右）＋青ボックス（右→左）──
    const serviceHero    = document.querySelector<HTMLElement>('[data-service-hero]');
    const serviceHeroImg = document.querySelector<HTMLElement>('[data-service-hero-img]');
    const serviceHeroBox = document.querySelector<HTMLElement>('[data-service-hero-box]');
    if (serviceHero && serviceHeroImg && serviceHeroBox) {
      const tlHero = gsap.timeline({
        scrollTrigger: { trigger: serviceHero, start: 'top 78%', once: true },
      });
      tlHero
        .fromTo(serviceHeroImg,
          { opacity: 0, x: -60 },
          { opacity: 1, x: 0, duration: 1.0, ease: 'power2.out' }
        )
        .fromTo(serviceHeroBox,
          { opacity: 0, x: 60 },
          { opacity: 1, x: 0, duration: 1.0, ease: 'power2.out' },
          '-=0.7'
        );
    }

    // ── 単体フェードイン（[data-fade] / card-row 以外）──
    gsap.utils.toArray<HTMLElement>('[data-fade]').forEach(function(el) {
      if (el.closest('[data-card-row]')) return;
      gsap.fromTo(el,
        { opacity: 0, y: 22 },
        {
          opacity: 1, y: 0, duration: 0.85, ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        }
      );
    });

    // ── サービスカード3枚：スタガーフェードイン ──────
    const cardRow = document.querySelector<HTMLElement>('[data-card-row]');
    if (cardRow) {
      gsap.fromTo(
        cardRow.querySelectorAll('[data-fade]'),
        { opacity: 0, y: 48 },
        {
          opacity: 1, y: 0, duration: 0.9, ease: 'power2.out', stagger: 0.18,
          scrollTrigger: { trigger: cardRow, start: 'top 75%', once: true },
        }
      );
    }

    // ── 強みセクション：左右スライドイン ────────────
    gsap.utils.toArray<HTMLElement>('[data-strength]').forEach(function(item) {
      const isRtl = item.dataset.strength === 'rtl';
      const imgW  = item.querySelector<HTMLElement>('[data-strength-img]');
      const txtW  = item.querySelector<HTMLElement>('[data-strength-text]');
      if (!imgW || !txtW) return;

      const tl = gsap.timeline({
        scrollTrigger: { trigger: item, start: 'top 75%', once: true },
      });
      tl.fromTo(imgW, { opacity: 0, x: isRtl ? 70 : -70 }, { opacity: 1, x: 0, duration: 0.9, ease: 'power2.out' })
        .fromTo(txtW, { opacity: 0, x: isRtl ? -70 : 70 }, { opacity: 1, x: 0, duration: 0.9, ease: 'power2.out' }, '-=0.6');
    });
  }

  document.addEventListener('astro:page-load', initIndexAnimations);
</script>
