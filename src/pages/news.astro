---
import Layout from '../layouts/Layout.astro';

const newsItems = [
  {
    id: '001',
    date: '2026-04-22',
    dateLabel: '2026.04.22',
    category: 'お知らせ',
    title: 'ゴールデンウィーク期間中（4/26〜5/6）の営業についてのお知らせ。',
  },
  {
    id: '002',
    date: '2026-03-02',
    dateLabel: '2026.03.02',
    category: '実績',
    title: '茨城県○○市「市制施行50周年記念式典」を開催いたしました。',
  },
  {
    id: '003',
    date: '2026-02-21',
    dateLabel: '2026.02.21',
    category: 'お知らせ',
    title: '新サービス「オンラインイベント支援プラン」の提供を開始しました。',
  },
  {
    id: '004',
    date: '2026-01-10',
    dateLabel: '2026.01.10',
    category: '新着情報',
    title: '2026年の営業開始は1月6日（火）からとなります。本年もどうぞよろしくお願いいたします。',
  },
  {
    id: '005',
    date: '2025-12-18',
    dateLabel: '2025.12.18',
    category: '実績',
    title: '（一社）茨城県観光物産協会「いばらき夏の観光キャンペーン2025」の企画運営を担当しました。',
  },
  {
    id: '006',
    date: '2025-11-04',
    dateLabel: '2025.11.04',
    category: 'お知らせ',
    title: '年末年始の休業期間（12/28〜1/5）についてのお知らせ。',
  },
];

const categoryColors: Record<string, string> = {
  'お知らせ': 'border-[#004896] text-[#004896]',
  '実績':     'border-[#4982C2] text-[#4982C2]',
  '新着情報': 'border-[#6CA87C] text-[#6CA87C]',
};
---
<Layout title="お知らせ | 株式会社 イトピック">
<main>

  <!-- =============================================
       PAGE HERO
  ============================================== -->
  <section
    id="page-hero-news"
    class="w-full bg-white relative overflow-hidden"
    style="max-height: 455px; min-height: clamp(200px, 28vw, 455px);"
  >
    <div
      class="hidden md:block absolute inset-y-0 right-0 w-full max-w-[1440px] pointer-events-none select-none"
      style="left: 50%; transform: translateX(-50%); z-index: 0;"
      aria-hidden="true"
    >
      <div class="absolute top-0 right-0"
           style="width: clamp(260px, 28vw, 420px); height: clamp(260px, 28vw, 420px); opacity: 0.55;">
        <img src="/images/ibaraki_bg.png" alt=""
             class="w-full h-full object-contain object-right-top" />
      </div>
    </div>
    <div
      class="relative z-10 w-full max-w-[1440px] mx-auto flex flex-col justify-center px-4 md:px-8 xl:px-0"
      style="min-height: clamp(200px, 28vw, 455px);"
    >
      <p class="font-inter font-bold text-[#4982C2] tracking-widest mb-4"
         style="font-size: var(--fs-small); letter-spacing: 0.18em;">News</p>
      <h1 class="font-noto font-bold text-[#333333] leading-tight mb-6"
          style="font-size: var(--fs-display);">お知らせ</h1>
      <nav aria-label="パンくずリスト">
        <ol class="flex items-center gap-2 flex-wrap">
          <li>
            <a href="/" class="font-noto font-medium text-[#333333] hover:text-[#004896] transition-colors duration-200"
               style="font-size: var(--fs-small);">ホーム</a>
          </li>
          <li class="font-noto font-medium text-[#333333]" style="font-size: var(--fs-small);" aria-hidden="true">&gt;</li>
          <li class="font-noto font-medium text-[#333333]" style="font-size: var(--fs-small);" aria-current="page">お知らせ</li>
        </ol>
      </nav>
    </div>
  </section>

  <!-- =============================================
       MAIN VISUAL
  ============================================== -->
  <div class="w-full overflow-hidden" style="height: clamp(240px, 40vw, 600px);">
    <img src="/images/news_mb.png" alt="お知らせメインビジュアル"
         class="w-full h-full object-cover object-center" />
  </div>

  <!-- =============================================
       NEWS LIST
  ============================================== -->
  <section id="news-list" class="w-full bg-white section-lg">
    <div class="w-full max-w-[1440px] mx-auto px-4 md:px-8 xl:px-0">

      <!-- セクションヘッダー -->
      <div class="mb-12 lg:mb-16">
        <p class="font-inter font-bold text-[#4982C2] tracking-widest mb-4"
           style="font-size: var(--fs-small); letter-spacing: 0.18em;">Latest News</p>
        <h2 class="font-noto font-bold text-[#004896] leading-tight"
            style="font-size: var(--fs-h2);">お知らせ</h2>
      </div>

      <!-- カテゴリフィルター -->
      <div class="flex flex-wrap items-center gap-3 mb-10 lg:mb-14"
           role="list" aria-label="カテゴリ絞り込み">
        <button
          type="button"
          data-filter="all"
          class="filter-btn active font-noto font-medium text-white bg-[#004896]
                 px-5 py-2 rounded-full border border-[#004896]
                 transition-colors duration-200"
          style="font-size: var(--fs-caption);"
        >
          すべて
        </button>
        <button
          type="button"
          data-filter="お知らせ"
          class="filter-btn font-noto font-medium text-[#004896] bg-white
                 px-5 py-2 rounded-full border border-[#004896]
                 hover:bg-[#004896] hover:text-white transition-colors duration-200"
          style="font-size: var(--fs-caption);"
        >
          お知らせ
        </button>
        <button
          type="button"
          data-filter="実績"
          class="filter-btn font-noto font-medium text-[#4982C2] bg-white
                 px-5 py-2 rounded-full border border-[#4982C2]
                 hover:bg-[#4982C2] hover:text-white transition-colors duration-200"
          style="font-size: var(--fs-caption);"
        >
          実績
        </button>
        <button
          type="button"
          data-filter="新着情報"
          class="filter-btn font-noto font-medium text-[#6CA87C] bg-white
                 px-5 py-2 rounded-full border border-[#6CA87C]
                 hover:bg-[#6CA87C] hover:text-white transition-colors duration-200"
          style="font-size: var(--fs-caption);"
        >
          新着情報
        </button>
      </div>

      <!-- ニュース一覧 -->
      <div id="news-list-items" class="border-t border-[#E0E6EF]">
        {newsItems.map((item) => (
          <article
            class="news-article"
            data-category={item.category}
          >
            <div
              class="flex flex-col sm:flex-row sm:items-center
                     gap-3 sm:gap-6
                     py-8 md:py-10
                     border-b border-[#E0E6EF]"
            >
              <!-- 日付 -->
              <time
                datetime={item.date}
                class="font-inter font-bold text-[#004896] flex-shrink-0 whitespace-nowrap"
                style="font-size: var(--fs-small);"
              >
                {item.dateLabel}
              </time>

              <!-- カテゴリタグ -->
              <span
                class={`flex-shrink-0 font-noto font-medium border
                        px-3 py-0.5 text-center whitespace-nowrap rounded-[2px]
                        ${categoryColors[item.category] ?? 'border-[#999] text-[#999]'}`}
                style="font-size: 12px; min-width: 80px;"
              >
                {item.category}
              </span>

              <!-- タイトル -->
              <p
                class="font-noto font-medium text-[#333333] leading-relaxed flex-1 min-w-0"
                style="font-size: var(--fs-body);"
              >
                {item.title}
              </p>
            </div>
          </article>
        ))}
      </div>

      <!-- フィルター結果なし表示 -->
      <p id="news-empty"
         class="hidden font-noto font-medium text-[#999] text-center py-20"
         style="font-size: var(--fs-body);">
        該当するお知らせはありません。
      </p>

      <!-- ページネーション -->
      <nav aria-label="ページナビゲーション"
           class="flex items-center justify-center gap-2 mt-16">
        <button
          type="button"
          disabled
          class="w-10 h-10 flex items-center justify-center rounded-[4px]
                 border border-[#E0E6EF] text-[#CCCCCC] cursor-not-allowed"
          aria-label="前のページ"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
               class="w-4 h-4">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <button
          type="button"
          class="w-10 h-10 flex items-center justify-center rounded-[4px]
                 border border-[#004896] bg-[#004896] text-white
                 font-inter font-bold"
          style="font-size: 14px;"
          aria-current="page"
          aria-label="1ページ目"
        >
          1
        </button>
        <button
          type="button"
          class="w-10 h-10 flex items-center justify-center rounded-[4px]
                 border border-[#E0E6EF] text-[#333333]
                 font-inter font-bold
                 hover:border-[#004896] hover:text-[#004896] transition-colors duration-200"
          style="font-size: 14px;"
          aria-label="2ページ目"
        >
          2
        </button>
        <button
          type="button"
          class="w-10 h-10 flex items-center justify-center rounded-[4px]
                 border border-[#E0E6EF] text-[#333333]
                 font-inter font-bold
                 hover:border-[#004896] hover:text-[#004896] transition-colors duration-200"
          style="font-size: 14px;"
          aria-label="3ページ目"
        >
          3
        </button>

        <button
          type="button"
          class="w-10 h-10 flex items-center justify-center rounded-[4px]
                 border border-[#E0E6EF] text-[#333333]
                 hover:border-[#004896] hover:text-[#004896] transition-colors duration-200"
          aria-label="次のページ"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
               class="w-4 h-4">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </nav>

    </div>
  </section>

</main>
</Layout>

<script>
  (function () {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const articles   = document.querySelectorAll<HTMLElement>('.news-article');
    const empty      = document.getElementById('news-empty');

    filterBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const filter = btn.getAttribute('data-filter') ?? 'all';

        // アクティブ状態の切り替え
        filterBtns.forEach(function (b) {
          b.classList.remove('active', 'text-white', 'bg-[#004896]', 'bg-[#4982C2]', 'bg-[#6CA87C]');
        });
        btn.classList.add('active');
        if (filter === 'all') {
          btn.classList.add('text-white', 'bg-[#004896]');
        } else if (filter === 'お知らせ') {
          btn.classList.add('text-white', 'bg-[#004896]');
        } else if (filter === '実績') {
          btn.classList.add('text-white', 'bg-[#4982C2]');
        } else if (filter === '新着情報') {
          btn.classList.add('text-white', 'bg-[#6CA87C]');
        }

        // 表示切り替え
        let visibleCount = 0;
        articles.forEach(function (article) {
          const cat = article.getAttribute('data-category') ?? '';
          if (filter === 'all' || cat === filter) {
            article.style.display = '';
            visibleCount++;
          } else {
            article.style.display = 'none';
          }
        });

        if (empty) {
          empty.classList.toggle('hidden', visibleCount > 0);
        }
      });
    });
  })();
</script>
