---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteLoader from '../components/SiteLoader.astro';
import { SITE_ORIGIN } from '../consts/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  ogImage?: string;
  ogType?: string;
}

const SITE_NAME = '株式会社イトピック';
const DEFAULT_OG_IMAGE = '/images/mb_bg.jpg';

const {
  title,
  description,
  bodyClass = 'font-noto text-[#333333] bg-white',
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
} = Astro.props;

const canonicalUrl = Astro.url.href;
const ogImageUrl = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, Astro.site ?? SITE_ORIGIN).href;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="ja_JP" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={ogImageUrl} />
  <link rel="icon" href="/images/favicon.ico" type="image/x-icon" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@700&family=Noto+Sans+JP:wght@500;700&display=swap" rel="stylesheet" />
  <style is:inline>
    #site-loader [data-logo-part] { opacity: 0; }
  </style>
  <script is:inline>
    (function () {
      try {
        if (
          sessionStorage.getItem('itpc-loader-seen') ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          document.documentElement.classList.add('loader-skip');
        }
      } catch (e) { /* noop */ }
    })();
  </script>
  <ViewTransitions />
</head>
<body class={bodyClass}>
  <SiteLoader />
  <Header />
  <div id="page-content" transition:animate="fade">
    <slot />
  </div>
  <Footer />
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    // ================================================================
    // Layout 管理の ScrollTrigger を掃除（ページ遷移時の重複防止）
    // ================================================================
    function killLayoutScrollTriggers() {
      ScrollTrigger.getAll().forEach(function(st) {
        const t = st.trigger as Element | null;
        // 前ページの DOM に紐づくトリガーは一掃
        if (!t || !document.body.contains(t)) {
          st.kill();
          return;
        }
        if (
          t.matches('[data-a="fade"], [data-a="stagger"]') ||
          t.hasAttribute('data-mv-parallax') ||
          t.id === 'contact'
        ) {
          st.kill();
        }
      });
    }

    function isAboveFold(el: HTMLElement, threshold = 0.88) {
      const rect = el.getBoundingClientRect();
      return rect.top < window.innerHeight * threshold && rect.bottom > 0;
    }

    // ================================================================
    // 共通フェード / スタガー
    // ================================================================
    function initFadeAnimations() {
      gsap.utils.toArray<HTMLElement>('[data-a="fade"]').forEach(function(el) {
        if (el.dataset.aInit === 'true') return;
        el.dataset.aInit = 'true';

        const tweenVars = {
          opacity: 1, y: 0, duration: 0.8, ease: 'power2.out',
        };

        if (isAboveFold(el)) {
          gsap.fromTo(el, { opacity: 0, y: 24 }, { ...tweenVars, delay: 0.05 });
        } else {
          gsap.fromTo(el,
            { opacity: 0, y: 24 },
            {
              ...tweenVars,
              scrollTrigger: { trigger: el, start: 'top 88%', once: true },
            }
          );
        }
      });

      gsap.utils.toArray<HTMLElement>('[data-a="stagger"]').forEach(function(container) {
        if (container.dataset.aInit === 'true') return;
        container.dataset.aInit = 'true';

        const children = Array.from(container.querySelectorAll<HTMLElement>(':scope > *'));
        if (!children.length) return;

        const tweenVars = {
          opacity: 1, y: 0, duration: 0.75, ease: 'power2.out', stagger: 0.12,
        };

        if (isAboveFold(container, 0.82)) {
          gsap.fromTo(children, { opacity: 0, y: 28 }, { ...tweenVars, delay: 0.05 });
        } else {
          gsap.fromTo(children,
            { opacity: 0, y: 28 },
            {
              ...tweenVars,
              scrollTrigger: { trigger: container, start: 'top 82%', once: true },
            }
          );
        }
      });
    }

    // ================================================================
    // メインビジュアル パララックス
    // ================================================================
    function setupMvParallax() {
      // 既存のMV ScrollTrigger を一掃してから再構築（ページ遷移対応）
      ScrollTrigger.getAll().forEach(function(st) {
        const t = st.trigger as Element | null;
        if (t && t.hasAttribute('data-mv-parallax')) st.kill();
      });

      // スマホ (< 768px) は負荷を避けてスキップ
      if (window.innerWidth < 768) return;

      // 静止時 scale なし（自然な object-cover）+ 上下にはみ出しで派手めに移動
      const MV_SHIFT = 0.35;  // コンテナ高さの 35% 分、上方向へ移動

      gsap.utils.toArray<HTMLElement>('[data-mv-parallax]').forEach(function(wrap) {
        const img = wrap.querySelector<HTMLElement>('img');
        if (!img) return;

        gsap.set(img, {
          top: `${-MV_SHIFT * 100}%`,
          left: 0,
          width: '100%',
          height: `${(1 + MV_SHIFT * 2) * 100}%`,
          y: 0,
          scale: 1,
          transformOrigin: 'center center',
        });

        gsap.to(img, {
          y: function() { return -MV_SHIFT * wrap.offsetHeight; },
          ease: 'none',
          scrollTrigger: {
            trigger: wrap,
            start: 'top 85%',
            end: 'bottom 15%',
            scrub: 0.5,
            invalidateOnRefresh: true,
          },
        });
      });

      ScrollTrigger.refresh();
    }

    // ================================================================
    // #contact グリッドリビール（背景・コンテンツの露出演出）
    // ================================================================
    function setupContactGridReveal() {
      // 既存の #contact 用 ScrollTrigger を一掃（ページ遷移対応）
      ScrollTrigger.getAll().forEach(function(st) {
        const t = st.trigger as HTMLElement | null;
        if (t && t.id === 'contact') st.kill();
      });

      document.querySelectorAll<HTMLElement>('#contact').forEach(function(section) {
        section.querySelector('.contact-grid-overlay')?.remove();
        delete section.dataset.gridAnim;

        const cols = window.innerWidth < 768 ? 10 : 15;
        const rows = window.innerWidth < 768 ? 8 : 10;

        const overlay = document.createElement('div');
        overlay.className = 'contact-grid-overlay';
        overlay.setAttribute('aria-hidden', 'true');
        overlay.style.setProperty('--contact-grid-cols', String(cols));
        overlay.style.setProperty('--contact-grid-rows', String(rows));

        const blocks: HTMLDivElement[] = [];
        for (let i = 0; i < cols * rows; i++) {
          const block = document.createElement('div');
          block.className = 'contact-grid-block';
          overlay.appendChild(block);
          blocks.push(block);
        }

        section.appendChild(overlay);
        gsap.set(blocks, { scale: 1, opacity: 1 });

        gsap.to(blocks, {
          scale: 0,
          opacity: 0,
          duration: 0.45,
          ease: 'power2.in',
          stagger: {
            amount: 1.0,
            grid: [rows, cols],
            from: 'end',   // 右下から左上へ → 下から上に消えていく印象
          },
          scrollTrigger: {
            trigger: section,
            start: 'top 80%',
            once: true,
          },
          onComplete: function() {
            overlay.remove();
          },
        });

        section.dataset.gridAnim = 'initialized';
      });
    }

    // ================================================================
    // 初期化エントリーポイント
    // ================================================================
    function initAll() {
      killLayoutScrollTriggers();
      initFadeAnimations();
      setupMvParallax();
      setupContactGridReveal();
    }

    // View Transitions: 初回ロード・ページ遷移のたびに再実行
    // 初回はスプラッシュ完了（loader:complete）後に初期化
    let isFirstPageLoad = true;
    document.addEventListener('astro:page-load', function () {
      if (!isFirstPageLoad) {
        initAll();
        return;
      }
      isFirstPageLoad = false;
      if (!document.getElementById('site-loader')) initAll();
    });
    document.addEventListener('loader:complete', initAll);
  </script>

  <script>
    // ── 下層ページ h1 一文字ずつフェードイン（Vanilla JS） ──
    function initPageTitleAnim() {
      document.querySelectorAll<HTMLElement>('[data-title-anim]').forEach(function (h1) {
        if (h1.dataset.anim === 'done') return;

        const text = h1.textContent?.trim() ?? '';
        h1.textContent = '';

        [...text].forEach(function (char, i) {
          const span = document.createElement('span');
          span.className = 'page-title-char';
          span.textContent = char;
          span.style.animationDelay = (i * 0.12) + 's';
          h1.appendChild(span);
        });

        h1.dataset.anim = 'done';
      });
    }

    document.addEventListener('astro:page-load', initPageTitleAnim);
  </script>
</body>
</html>
