---
import { Image } from 'astro:assets';
import contactBg from '../assets/images/contact_bg.jpg';
---
<section id="contact" class="w-full relative overflow-hidden">

  <div class="absolute inset-0" aria-hidden="true">
    <Image src={contactBg} alt=""
           class="w-full h-[180%] md:h-full object-cover object-center md:object-[center_70%]" />
    <div class="absolute inset-0 bg-[rgba(20,28,50,0.8)]"></div>
  </div>

  <div class="relative z-10 w-full max-w-[1440px] mx-auto px-6 md:px-8 section-md">

    <p class="font-inter font-bold text-white text-center tracking-[4px] mb-5 opacity-90"  style="font-size: var(--fs-small);">Contact</p>
    <h2 class="font-noto font-bold text-white text-center leading-tight mb-6 md:mb-8"  style="font-size: var(--fs-h1);">お問い合わせ</h2>
    <p class="font-noto font-medium text-white text-center opacity-90 mb-6 md:mb-16 leading-loose md:leading-relaxed"  style="font-size: var(--fs-body);">
      お客様のご要望に応じさまざまなご提案が可能です。<br class="block lg:hidden" />お気軽にご相談ください。
    </p>

    <div class="w-full bg-white">
      <div class="flex flex-col lg:flex-row divide-y lg:divide-y-0 lg:divide-x divide-[#E0E6EF]">
        <div class="flex-1 flex flex-col items-center justify-center px-6 py-12 md:px-8 md:py-14 lg:py-16">
          <p class="font-noto font-bold text-[#333333] mb-8 text-center"  style="font-size: var(--fs-h4);">フォームでのお問い合わせ</p>
          <a href="/contact"
             class="group font-noto font-medium text-white inline-flex items-center justify-between w-full max-w-[320px] px-7 py-4 rounded-[8px] transition-opacity duration-300 hover:opacity-85 bg-[linear-gradient(to_right,#4982C2,#004896)]"  style="font-size: var(--fs-body);">
            お問い合わせフォーム
            <span class="font-inter font-bold inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
        </div>
        <div class="flex-1 flex flex-col items-center justify-center px-6 py-12 md:px-8 md:py-14 lg:py-16">
          <p class="font-noto font-bold text-[#333333] mb-6 text-center"  style="font-size: var(--fs-h4);">お電話でのお問い合わせ</p>
          <a href="tel:0292534387"
             class="font-inter font-bold text-[#004896] hover:opacity-75 transition-opacity duration-200 mb-3 tracking-[0.02em] leading-none"  style="font-size: var(--fs-h1);">
            029-253-4387
          </a>
          <p class="font-noto font-medium text-[#333333] opacity-60"  style="font-size: var(--fs-caption);">受付時間：平日 9:00〜18:00（土日祝を除く）</p>
        </div>
      </div>
    </div>

  </div>
</section>
